// Staging Worker (plan Section 5.1), served only at https://airstock.deletecookies.dev.
// Resource IDs are not secrets. Secrets are set with `wrangler secret put`; see
// docs/staging.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "airstock-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "airstock.deletecookies.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  // Run near the Neon database (aws-eu-central-1): every SQL statement is a round trip.
  // M1 compares this with Smart Placement and records the result.
  "placement": { "mode": "smart" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d4107a1ef7aa4b6ea8935a208edb0512",
      "localConnectionString": "postgres://airstock_app:airstock_app@localhost:54329/airstock_dev"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "airstock-staging-files", "jurisdiction": "eu" }
  ],
  "queues": {
    "producers": [
      { "binding": "AUDIT_QUEUE", "queue": "airstock-staging-audit" },
      { "binding": "JOBS_QUEUE", "queue": "airstock-staging-jobs" }
    ],
    "consumers": [
      {
        "queue": "airstock-staging-audit",
        "max_batch_size": 100,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "dead_letter_queue": "airstock-staging-audit-dlq"
      },
      {
        "queue": "airstock-staging-jobs",
        "max_batch_size": 10,
        // Orders and pushes are latency-sensitive; do not wait for a fuller batch.
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "airstock-staging-jobs-dlq"
      }
    ]
  },
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
  // Static files for the dashboard shell; everything else runs the Worker.
  "assets": { "directory": "./public" },
  // Public settings. Secrets (WORKOS_API_KEY, SESSION_SECRET, SHOPIFY_API_SECRET, SHOPIFY_TOKEN_KEY,
  // SMOKE_SECRET)
  // are set with `wrangler secret put`.
  "vars": {
    "PUBLIC_URL": "https://airstock.deletecookies.dev",
    "WORKOS_CLIENT_ID": "client_01M7CV6VA3GMRS5MYZ2GC1TJNS",
    "MCP_ISSUER": "https://tranquil-mirror-83-staging.authkit.app",
    "MCP_JWKS_URL": "https://tranquil-mirror-83-staging.authkit.app/oauth2/jwks",
    "MCP_AUTHORIZATION_SERVER": "https://tranquil-mirror-83-staging.authkit.app",
    "MCP_AUDIENCE": "https://airstock.deletecookies.dev/mcp",
    "MCP_RESOURCE_URL": "https://airstock.deletecookies.dev/mcp",
    // The consent step puts the grant ID in this claim (plan Section 7.2, option A).
    "MCP_GRANT_CLAIM": "urn:airstock:grant",
    // Shopify app "Airstock Staging" (plan M6). The token key itself is a secret.
    "SHOPIFY_CLIENT_ID": "5023573bb7a0db1c57597424be17feff",
    "SHOPIFY_TOKEN_KEY_ID": "k1"
  }
}
