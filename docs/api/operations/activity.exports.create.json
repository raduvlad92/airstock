{
  "/api/v1/shops/{shopId}/activity/exports": {
    "post": {
      "operationId": "activity.exports.create",
      "summary": "Export the activity history as CSV",
      "description": "Writes the events matching the filters (the same as the activity list) as CSV, newest first, at most 50,000 per file, as a job. The file is ready for 24 hours and listed with the other exports; creating, finishing, and downloading it are all in the history.",
      "x-permission": "exports.run",
      "x-connection-scope": "activity:read",
      "x-audit-action": "activity.export.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "actorType": {
                  "description": "Who acted: a person, an API credential, an AI connection, a connector such as Shopify, or the system.",
                  "type": "string",
                  "enum": [
                    "user",
                    "api_credential",
                    "connection",
                    "connector",
                    "system"
                  ]
                },
                "actorId": {
                  "description": "A user, API credential, connection, or connector ID, or a system job name.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "source": {
                  "description": "Where the request came from.",
                  "type": "string",
                  "enum": [
                    "dashboard",
                    "api",
                    "mcp",
                    "import",
                    "scheduled",
                    "admin",
                    "shopify",
                    "webhooks"
                  ]
                },
                "from": {
                  "description": "Events at or after this time (ISO 8601).",
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "to": {
                  "description": "Events before this time (ISO 8601).",
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "targetType": {
                  "description": "The kind of record, such as product, variant, location, warehouse, or import.",
                  "type": "string",
                  "maxLength": 50
                },
                "targetId": {
                  "description": "The record’s ID.",
                  "type": "string",
                  "maxLength": 100
                },
                "action": {
                  "description": "An action such as inventory.receipt.created, or a prefix ending in * such as inventory.*. Several, comma-separated, match any.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "received",
                    "succeeded",
                    "failed",
                    "denied",
                    "cancelled",
                    "conflict",
                    "no_change",
                    "replayed",
                    "unknown"
                  ]
                },
                "phase": {
                  "description": "attempt: commands as they arrived; outcome: what happened.",
                  "type": "string",
                  "enum": [
                    "attempt",
                    "outcome"
                  ]
                },
                "locationId": {
                  "description": "A warehouse or location: events about it or any location inside it.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "integration": {
                  "description": "An API credential, AI connection, or connector ID, or a client ID such as shopify: what that integration did.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "attemptId": {
                  "description": "One request (a batch): its attempt, its outcome, and every record it changed, such as each row of a bulk edit or an import.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "operationId": {
                  "description": "An inventory operation, as returned by stock commands.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "export": {
                    "type": "object",
                    "properties": {
                      "exportId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "catalog",
                          "activity",
                          "lot_trace"
                        ],
                        "description": "catalog: products or variants; activity: the activity history; lot_trace: one lot’s trace."
                      },
                      "status": {
                        "type": "string"
                      },
                      "rowCount": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "error": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "completedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "downloadUntil": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "downloadPath": {
                        "description": "An API path, not a link to share: the file downloads in the dashboard (Products, then Import, Recent exports) while signed in.",
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "exportId",
                      "kind",
                      "status",
                      "rowCount",
                      "error",
                      "createdAt",
                      "completedAt",
                      "downloadUntil",
                      "downloadPath"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "export"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
