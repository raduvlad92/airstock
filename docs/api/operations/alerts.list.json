{
  "/api/v1/shops/{shopId}/alerts": {
    "get": {
      "operationId": "alerts.list",
      "summary": "List stock alerts",
      "description": "Use this when someone asks what needs attention or what is running low: open and acknowledged alerts (low stock, lots nearing expiry, shortages, stock check problems), newest first, within your locations. Filter by kind, status, warehouse, or variant. Not for stock levels (use get_stock) or drafting orders (use manage_purchasing).",
      "x-permission": "inventory.read",
      "x-connection-scope": "inventory:read",
      "x-audit-action": "alerts.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "status",
          "in": "query",
          "required": false,
          "schema": {
            "default": "active",
            "description": "active (the default) is open and acknowledged.",
            "type": "string",
            "enum": [
              "active",
              "open",
              "acknowledged",
              "resolved",
              "all"
            ]
          }
        },
        {
          "name": "kind",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "low_stock",
              "lot_expiring",
              "shortage",
              "shopify_sync",
              "reconciliation_mismatch"
            ]
          }
        },
        {
          "name": "warehouseId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        {
          "name": "variantId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        {
          "name": "after",
          "in": "query",
          "required": false,
          "schema": {
            "description": "Cursor from the previous page.",
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "alerts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "low_stock",
                            "lot_expiring",
                            "shortage",
                            "shopify_sync",
                            "reconciliation_mismatch"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "open",
                            "acknowledged",
                            "resolved"
                          ]
                        },
                        "title": {
                          "type": "string",
                          "description": "One line for a person, such as \"Low stock: MUG-01 at Main\"."
                        },
                        "variantId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "warehouseId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "ruleId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "lotId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "details": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        },
                        "openedAt": {
                          "type": "string"
                        },
                        "lastSeenAt": {
                          "type": "string"
                        },
                        "acknowledgedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "acknowledgedBy": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "resolvedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "resolution": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "version": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id",
                        "kind",
                        "status",
                        "title",
                        "variantId",
                        "warehouseId",
                        "ruleId",
                        "lotId",
                        "details",
                        "openedAt",
                        "lastSeenAt",
                        "acknowledgedAt",
                        "acknowledgedBy",
                        "resolvedAt",
                        "resolution",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "alerts",
                  "nextCursor"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
