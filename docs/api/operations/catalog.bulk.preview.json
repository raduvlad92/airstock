{
  "/api/v1/shops/{shopId}/bulk-edits": {
    "post": {
      "operationId": "catalog.bulk.preview",
      "summary": "Preview a change to many products or variants",
      "description": "Validates up to 500 records' changes without saving them and returns each value before and after. If everything is valid you get a previewId, valid for 15 minutes; show the preview, then commit it with bulk_commit.",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.bulk.previewed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "edits": {
                  "minItems": 1,
                  "maxItems": 5000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "productId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "variantId": {
                        "description": "Leave out to change the product itself.",
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "field": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "A built-in field or a custom field key, as in update."
                      },
                      "value": {
                        "description": "The new value; null clears it."
                      },
                      "inherit": {
                        "description": "Variants only: inherit the product’s value again.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "productId",
                      "field"
                    ]
                  }
                }
              },
              "required": [
                "edits"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "previewId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Null when some changes are invalid; fix them and preview again."
                  },
                  "expiresAt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "records": {
                    "type": "number"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "variantId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "field": {
                          "type": "string"
                        },
                        "before": {},
                        "after": {}
                      },
                      "required": [
                        "productId",
                        "variantId",
                        "field",
                        "before",
                        "after"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      },
                      "required": [
                        "productId",
                        "code",
                        "message",
                        "details"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "previewId",
                  "expiresAt",
                  "records",
                  "lines",
                  "errors"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
