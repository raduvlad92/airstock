{
  "/api/v1/shops/{shopId}/items/duplicates": {
    "post": {
      "operationId": "catalog.duplicates.check",
      "summary": "Check a name, SKU, or barcode for duplicates before creating",
      "description": "Returns the record already using the SKU or barcode, and products with similar names. Creating with a taken SKU or barcode is refused; creating with a similar name needs acknowledgeSimilar.",
      "x-permission": "catalog.read",
      "x-connection-scope": "catalog:read",
      "x-audit-action": "catalog.duplicates.checked",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 500
                },
                "sku": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "barcode": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "excludeProductId": {
                  "description": "Leave this product out, when renaming it.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "skuTaken": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "variantId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "productId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "sku": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "variantId",
                          "productId",
                          "sku",
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "barcodeTaken": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "ownerType": {
                            "type": "string"
                          },
                          "ownerId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "code": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "ownerType",
                          "ownerId",
                          "code"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "similarNames": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "similarity": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "productId",
                        "name",
                        "similarity"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "skuTaken",
                  "barcodeTaken",
                  "similarNames"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
