{
  "/api/v1/shops/{shopId}/catalog/fields/{fieldId}/options": {
    "post": {
      "operationId": "catalog.field_options.update",
      "summary": "Add, rename, reorder, archive, or restore the options of a select field",
      "description": "Options keep their IDs, so renaming one changes every record that has it. An archived option stays on existing records but is not offered for new choices.",
      "x-permission": "catalog.schema.manage",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.field_options.updated",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "fieldId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "add": {
                  "description": "New option labels.",
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "rename": {
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "optionId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "optionId",
                      "label"
                    ]
                  }
                },
                "archive": {
                  "description": "Option IDs to archive.",
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "restore": {
                  "description": "Option IDs to restore.",
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "order": {
                  "description": "Option IDs in the new order; unlisted ones follow.",
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "key": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "description": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "text",
                          "rich_text",
                          "integer",
                          "decimal",
                          "boolean",
                          "date",
                          "timestamp",
                          "single_select",
                          "multi_select",
                          "money",
                          "measurement",
                          "file",
                          "relationship"
                        ]
                      },
                      "level": {
                        "type": "string",
                        "enum": [
                          "product",
                          "variant",
                          "both"
                        ]
                      },
                      "config": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      "defaultValue": {},
                      "visibility": {
                        "type": "string",
                        "enum": [
                          "everyone",
                          "restricted"
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "active",
                          "archived"
                        ]
                      },
                      "isSystem": {
                        "type": "boolean"
                      },
                      "version": {
                        "type": "number"
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "label": {
                              "type": "string"
                            },
                            "position": {
                              "type": "number"
                            },
                            "archived": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "id",
                            "label",
                            "position",
                            "archived"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "key",
                      "label",
                      "description",
                      "type",
                      "level",
                      "config",
                      "defaultValue",
                      "visibility",
                      "status",
                      "isSystem",
                      "version",
                      "options"
                    ],
                    "additionalProperties": false
                  },
                  "added": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    }
                  }
                },
                "required": [
                  "field",
                  "added"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
