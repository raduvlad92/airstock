{
  "/api/v1/shops/{shopId}/catalog/fields/{fieldId}/convert": {
    "post": {
      "operationId": "catalog.fields.convert",
      "summary": "Change a field to a compatible type, with a preview of affected records",
      "description": "Safe changes only: integer to decimal, single to multi select, text to rich text, decimal to money or to a measurement in a chosen unit. Run with preview true first; it changes nothing and shows how many records have a value.",
      "x-permission": "catalog.schema.manage",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.field.converted",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "fieldId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "toType": {
                  "type": "string",
                  "enum": [
                    "text",
                    "rich_text",
                    "integer",
                    "decimal",
                    "boolean",
                    "date",
                    "timestamp",
                    "single_select",
                    "multi_select",
                    "money",
                    "measurement",
                    "file",
                    "relationship"
                  ]
                },
                "unit": {
                  "description": "decimal to measurement: the unit existing values are in.",
                  "type": "string",
                  "maxLength": 10
                },
                "preview": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": [
                "toType"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "preview": {
                    "type": "boolean"
                  },
                  "affected": {
                    "type": "object",
                    "properties": {
                      "products": {
                        "type": "number"
                      },
                      "variants": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "products",
                      "variants"
                    ],
                    "additionalProperties": false
                  },
                  "field": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "key": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "text",
                              "rich_text",
                              "integer",
                              "decimal",
                              "boolean",
                              "date",
                              "timestamp",
                              "single_select",
                              "multi_select",
                              "money",
                              "measurement",
                              "file",
                              "relationship"
                            ]
                          },
                          "level": {
                            "type": "string",
                            "enum": [
                              "product",
                              "variant",
                              "both"
                            ]
                          },
                          "config": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          },
                          "defaultValue": {},
                          "visibility": {
                            "type": "string",
                            "enum": [
                              "everyone",
                              "restricted"
                            ]
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "active",
                              "archived"
                            ]
                          },
                          "isSystem": {
                            "type": "boolean"
                          },
                          "version": {
                            "type": "number"
                          },
                          "options": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "label": {
                                  "type": "string"
                                },
                                "position": {
                                  "type": "number"
                                },
                                "archived": {
                                  "type": "boolean"
                                }
                              },
                              "required": [
                                "id",
                                "label",
                                "position",
                                "archived"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "id",
                          "key",
                          "label",
                          "description",
                          "type",
                          "level",
                          "config",
                          "defaultValue",
                          "visibility",
                          "status",
                          "isSystem",
                          "version",
                          "options"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "preview",
                  "affected",
                  "field"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
