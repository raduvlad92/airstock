{
  "/api/v1/shops/{shopId}/items": {
    "post": {
      "operationId": "catalog.items.create",
      "summary": "Create a product with its default variant",
      "description": "Creates a product and the default variant that carries its SKU and price. `fields` takes custom field values by key (see describe_catalog); variant-level fields go to the default variant. Add size or colour variants afterwards with generate_variants. A SKU that matches an existing one after normalization is rejected.",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.item.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "sku": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "price": {
                  "description": "Decimal string such as \"19.90\".",
                  "type": "string",
                  "maxLength": 30
                },
                "baseUnit": {
                  "default": "each",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20
                },
                "quantityScale": {
                  "default": 0,
                  "description": "Decimal places allowed in stock quantities, 0 for whole units.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "description": {
                  "description": "Markdown text.",
                  "type": "string",
                  "maxLength": 50000
                },
                "status": {
                  "default": "active",
                  "type": "string",
                  "enum": [
                    "draft",
                    "active"
                  ]
                },
                "family": {
                  "description": "Family ID or name.",
                  "type": "string",
                  "maxLength": 200
                },
                "tags": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "weight": {
                  "description": "Such as \"1.2 kg\" or {value, unit}."
                },
                "dimensions": {
                  "description": "Such as \"120 x 60 x 75 cm\" or {length, width, height, unit}."
                },
                "fields": {
                  "description": "Custom field values by key.",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "barcode": {
                  "description": "The barcode printed on the item, such as its EAN-13. The type is detected from the code; a code another item or pack already has is refused.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "acknowledgeSimilar": {
                  "default": false,
                  "description": "Products with similar names make the create fail with `similar_items_found` and the matches. Show them, and only after the person confirms it is a different product, retry with true.",
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "sku"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "variantId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "sku": {
                    "type": "string"
                  },
                  "item": {
                    "type": "object",
                    "properties": {
                      "product": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "draft",
                              "active",
                              "archived",
                              "sold"
                            ],
                            "description": "sold: a one-of-a-kind item that was fulfilled; it is active again if it returns."
                          },
                          "family": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                  },
                                  "name": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "id",
                                  "name"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "tags": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "weight": {},
                          "dimensions": {},
                          "version": {
                            "type": "number"
                          },
                          "createdAt": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string"
                          },
                          "fields": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "object",
                              "properties": {
                                "value": {},
                                "display": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "source": {
                                  "type": "string",
                                  "enum": [
                                    "own",
                                    "inherited",
                                    "cleared",
                                    "none"
                                  ]
                                }
                              },
                              "required": [
                                "value",
                                "display",
                                "source"
                              ],
                              "additionalProperties": false
                            },
                            "description": "Custom fields by key."
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "description",
                          "status",
                          "family",
                          "tags",
                          "weight",
                          "dimensions",
                          "version",
                          "createdAt",
                          "updatedAt",
                          "fields"
                        ],
                        "additionalProperties": false
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "name": {
                              "type": "string"
                            },
                            "position": {
                              "type": "number"
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                  },
                                  "label": {
                                    "type": "string"
                                  },
                                  "position": {
                                    "type": "number"
                                  }
                                },
                                "required": [
                                  "id",
                                  "label",
                                  "position"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "position",
                            "values"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "variants": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "sku": {
                              "type": "string"
                            },
                            "title": {
                              "type": "string",
                              "description": "Option values, such as \"Black / M\"; empty for a single variant."
                            },
                            "optionValues": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {
                                "type": "string"
                              },
                              "description": "Option name → value label."
                            },
                            "optionValueIds": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              }
                            },
                            "price": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "baseUnit": {
                              "type": "string"
                            },
                            "quantityScale": {
                              "type": "number"
                            },
                            "trackingMode": {
                              "type": "string"
                            },
                            "oneOfAKind": {
                              "type": "boolean"
                            },
                            "sellByMarginDays": {
                              "type": "number"
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "active",
                                "archived"
                              ]
                            },
                            "isDefault": {
                              "type": "boolean"
                            },
                            "version": {
                              "type": "number"
                            },
                            "weight": {
                              "type": "object",
                              "properties": {
                                "value": {},
                                "display": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "source": {
                                  "type": "string",
                                  "enum": [
                                    "own",
                                    "inherited",
                                    "cleared",
                                    "none"
                                  ]
                                }
                              },
                              "required": [
                                "value",
                                "display",
                                "source"
                              ],
                              "additionalProperties": false
                            },
                            "dimensions": {
                              "type": "object",
                              "properties": {
                                "value": {},
                                "display": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "source": {
                                  "type": "string",
                                  "enum": [
                                    "own",
                                    "inherited",
                                    "cleared",
                                    "none"
                                  ]
                                }
                              },
                              "required": [
                                "value",
                                "display",
                                "source"
                              ],
                              "additionalProperties": false
                            },
                            "fields": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {
                                "type": "object",
                                "properties": {
                                  "value": {},
                                  "display": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "source": {
                                    "type": "string",
                                    "enum": [
                                      "own",
                                      "inherited",
                                      "cleared",
                                      "none"
                                    ]
                                  }
                                },
                                "required": [
                                  "value",
                                  "display",
                                  "source"
                                ],
                                "additionalProperties": false
                              },
                              "description": "Custom fields by key."
                            }
                          },
                          "required": [
                            "id",
                            "sku",
                            "title",
                            "optionValues",
                            "optionValueIds",
                            "price",
                            "baseUnit",
                            "quantityScale",
                            "trackingMode",
                            "oneOfAKind",
                            "sellByMarginDays",
                            "status",
                            "isDefault",
                            "version",
                            "weight",
                            "dimensions",
                            "fields"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "incoming": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string"
                            },
                            "relationKind": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "sourceType": {
                              "type": "string",
                              "enum": [
                                "product",
                                "variant"
                              ]
                            },
                            "sourceId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "sourceName": {
                              "type": "string"
                            },
                            "targetId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            }
                          },
                          "required": [
                            "field",
                            "relationKind",
                            "sourceType",
                            "sourceId",
                            "sourceName",
                            "targetId"
                          ],
                          "additionalProperties": false
                        },
                        "description": "Relationships other records have to this one, such as \"replaces\"."
                      }
                    },
                    "required": [
                      "product",
                      "options",
                      "variants",
                      "incoming"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "productId",
                  "variantId",
                  "sku",
                  "item"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
