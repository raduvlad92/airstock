{
  "/api/v1/shops/{shopId}/media/{mediaId}/links/update": {
    "post": {
      "operationId": "catalog.media.links.update",
      "summary": "Change a file’s role, alt text, or primary flag on a product or variant",
      "description": "Leave out variantId for the product itself. primary true makes it the scope’s only primary picture; false leaves the scope without one.",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.media.link_updated",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "mediaId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "The product."
                },
                "variantId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "A variant of the product. Leave out for the product itself."
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "Any role, such as primary, lifestyle, detail, packaging, dimension_diagram, or swatch."
                },
                "altText": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 1000
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Text describing the picture for people who cannot see it; null clears it."
                },
                "primary": {
                  "type": "boolean",
                  "description": "Make this the primary picture of its scope (images only)."
                }
              },
              "required": [
                "productId"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "link": {
                    "type": "object",
                    "properties": {
                      "linkId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "mediaId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "productId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "variantId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Null for the product itself."
                      },
                      "role": {
                        "type": "string"
                      },
                      "roleLabel": {
                        "type": "string"
                      },
                      "position": {
                        "type": "number"
                      },
                      "primary": {
                        "type": "boolean"
                      },
                      "altText": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "linkId",
                      "mediaId",
                      "productId",
                      "variantId",
                      "role",
                      "roleLabel",
                      "position",
                      "primary",
                      "altText"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "link"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
