{
  "/api/v1/shops/{shopId}/media/{mediaId}/links/remove": {
    "post": {
      "operationId": "catalog.media.unlink",
      "summary": "Remove a file from a product or some of its variants",
      "description": "scope both (default) removes it from the product and every variant, or the listed ones; variants only from variants (all when none are listed); product only from the product itself. The file stays in the shop’s media library. If a primary picture is removed, the next image in that scope becomes primary.",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.media.unlinked",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "mediaId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "The product."
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "product",
                    "variants",
                    "both"
                  ],
                  "description": "product: the product itself, shown for every variant. variants: only the listed variants. both: the product and the listed variants."
                },
                "variantIds": {
                  "anyOf": [
                    {
                      "maxItems": 2048,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      }
                    },
                    {
                      "type": "string",
                      "maxLength": 80000
                    }
                  ],
                  "description": "IDs as an array, or comma-separated."
                }
              },
              "required": [
                "productId"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "linkId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "mediaId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "productId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "variantId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Null for the product itself."
                        },
                        "role": {
                          "type": "string"
                        },
                        "roleLabel": {
                          "type": "string"
                        },
                        "position": {
                          "type": "number"
                        },
                        "primary": {
                          "type": "boolean"
                        },
                        "altText": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "linkId",
                        "mediaId",
                        "productId",
                        "variantId",
                        "role",
                        "roleLabel",
                        "position",
                        "primary",
                        "altText"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Every link of this media item on the product."
                  }
                },
                "required": [
                  "links"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
