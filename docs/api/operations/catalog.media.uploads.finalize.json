{
  "/api/v1/shops/{shopId}/media/uploads/{intentId}/finalize": {
    "post": {
      "operationId": "catalog.media.uploads.finalize",
      "summary": "Finish an upload and attach the file",
      "description": "After every part is uploaded, creates the media item and, when productId is given, links it in one step. An upload that is never finalized expires after 15 minutes and its files are deleted.",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.media.finalized",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "intentId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "The product."
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "product",
                    "variants",
                    "both"
                  ],
                  "description": "product: the product itself, shown for every variant. variants: only the listed variants. both: the product and the listed variants."
                },
                "variantIds": {
                  "anyOf": [
                    {
                      "maxItems": 2048,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      }
                    },
                    {
                      "type": "string",
                      "maxLength": 80000
                    }
                  ],
                  "description": "IDs as an array, or comma-separated."
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "Any role, such as primary, lifestyle, detail, packaging, dimension_diagram, or swatch."
                },
                "altText": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 1000
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Text describing the picture for people who cannot see it; null clears it."
                },
                "primary": {
                  "type": "boolean",
                  "description": "Make this the primary picture of its scope (images only)."
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "media": {
                    "type": "object",
                    "properties": {
                      "mediaId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "image",
                          "document"
                        ]
                      },
                      "fileName": {
                        "type": "string"
                      },
                      "contentType": {
                        "type": "string"
                      },
                      "size": {
                        "type": "number",
                        "description": "Bytes of the original file."
                      },
                      "sha256": {
                        "type": "string"
                      },
                      "width": {
                        "description": "Pixels, for images whose header could be read.",
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "height": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "thumbnail": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "url": {
                                "description": "Signed link, valid at least 15 minutes. Null when media delivery is not set up.",
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "contentType": {
                                "type": "string"
                              },
                              "size": {
                                "type": "number",
                                "description": "Bytes."
                              },
                              "width": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              },
                              "height": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "url",
                              "contentType",
                              "size",
                              "width",
                              "height"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Up to 320 px. Images only."
                      },
                      "display": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "url": {
                                "description": "Signed link, valid at least 15 minutes. Null when media delivery is not set up.",
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "contentType": {
                                "type": "string"
                              },
                              "size": {
                                "type": "number",
                                "description": "Bytes."
                              },
                              "width": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              },
                              "height": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "url",
                              "contentType",
                              "size",
                              "width",
                              "height"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Up to 1,600 px. Images only."
                      }
                    },
                    "required": [
                      "mediaId",
                      "kind",
                      "fileName",
                      "contentType",
                      "size",
                      "sha256",
                      "width",
                      "height",
                      "createdAt",
                      "thumbnail",
                      "display"
                    ],
                    "additionalProperties": false
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "linkId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "mediaId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "productId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "variantId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Null for the product itself."
                        },
                        "role": {
                          "type": "string"
                        },
                        "roleLabel": {
                          "type": "string"
                        },
                        "position": {
                          "type": "number"
                        },
                        "primary": {
                          "type": "boolean"
                        },
                        "altText": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "linkId",
                        "mediaId",
                        "productId",
                        "variantId",
                        "role",
                        "roleLabel",
                        "position",
                        "primary",
                        "altText"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "media",
                  "links"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
