{
  "/api/v1/shops/{shopId}/variants/{variantId}/packaging": {
    "get": {
      "operationId": "catalog.packaging.get",
      "summary": "Get the packs, barcodes, shipping packages, and bundle of a variant",
      "description": "Packs with their exact base quantities, every barcode of the variant and its packs, the boxes one unit ships in, and the bundle definition if the variant is one. The versions are what set_packs, set_barcodes, set_shipping_packages, and set_bundle expect.",
      "x-permission": "catalog.read",
      "x-connection-scope": "catalog:read",
      "x-audit-action": "catalog.packaging.viewed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "variantId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "includeArchived",
          "in": "query",
          "required": false,
          "schema": {
            "description": "Also list archived packs.",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "variantId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "productId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "productName": {
                    "type": "string"
                  },
                  "sku": {
                    "type": "string"
                  },
                  "baseUnit": {
                    "type": "string"
                  },
                  "quantityScale": {
                    "type": "number"
                  },
                  "price": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "packsVersion": {
                    "type": "number"
                  },
                  "barcodesVersion": {
                    "type": "number"
                  },
                  "shippingPackagesVersion": {
                    "type": "number"
                  },
                  "bundleVersion": {
                    "type": "number",
                    "description": "0 until the variant is first made a bundle."
                  },
                  "packs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "string",
                          "description": "Base units, or inner packs when innerPackId is set."
                        },
                        "innerPackId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "innerPackName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "baseQuantity": {
                          "type": "string",
                          "description": "Base units in one pack, through any inner packs."
                        },
                        "uses": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "purchasing",
                              "counting",
                              "transfer",
                              "sales"
                            ]
                          }
                        },
                        "dimensions": {},
                        "weight": {},
                        "price": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "active",
                            "archived"
                          ]
                        },
                        "version": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "quantity",
                        "innerPackId",
                        "innerPackName",
                        "baseQuantity",
                        "uses",
                        "dimensions",
                        "weight",
                        "price",
                        "status",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "barcodes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "code": {
                          "type": "string"
                        },
                        "symbology": {
                          "type": "string",
                          "enum": [
                            "ean13",
                            "ean8",
                            "upca",
                            "code128",
                            "qr",
                            "other"
                          ]
                        },
                        "packId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Null for the variant’s own barcode."
                        },
                        "source": {
                          "type": "string",
                          "enum": [
                            "entered",
                            "generated"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "code",
                        "symbology",
                        "packId",
                        "source"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "shippingPackages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "dimensions": {},
                        "weight": {}
                      },
                      "required": [
                        "id",
                        "name",
                        "dimensions",
                        "weight"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "bundle": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "version": {
                            "type": "number"
                          },
                          "active": {
                            "type": "boolean"
                          },
                          "components": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "variantId": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "sku": {
                                  "type": "string"
                                },
                                "productName": {
                                  "type": "string"
                                },
                                "title": {
                                  "type": "string"
                                },
                                "packId": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "packName": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "quantity": {
                                  "type": "string",
                                  "description": "Packs when packId is set, otherwise base units."
                                },
                                "baseQuantity": {
                                  "type": "string",
                                  "description": "Base units of the component in one bundle."
                                },
                                "status": {
                                  "type": "string",
                                  "description": "The component variant’s status."
                                }
                              },
                              "required": [
                                "variantId",
                                "sku",
                                "productName",
                                "title",
                                "packId",
                                "packName",
                                "quantity",
                                "baseQuantity",
                                "status"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "version",
                          "active",
                          "components"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Set when the variant is or was a bundle; inactive means it has no components."
                  },
                  "componentOf": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "variantId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "sku": {
                          "type": "string"
                        },
                        "productName": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "variantId",
                        "sku",
                        "productName"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Bundles that contain this variant."
                  }
                },
                "required": [
                  "variantId",
                  "productId",
                  "productName",
                  "sku",
                  "baseUnit",
                  "quantityScale",
                  "price",
                  "packsVersion",
                  "barcodesVersion",
                  "shippingPackagesVersion",
                  "bundleVersion",
                  "packs",
                  "barcodes",
                  "shippingPackages",
                  "bundle",
                  "componentOf"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
