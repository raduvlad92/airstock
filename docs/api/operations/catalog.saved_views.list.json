{
  "/api/v1/shops/{shopId}/saved-views": {
    "get": {
      "operationId": "catalog.saved_views.list",
      "summary": "List your saved views and the shop’s shared ones",
      "x-permission": "catalog.read",
      "x-connection-scope": "session",
      "x-audit-action": "catalog.saved_views.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "views": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "shared": {
                          "type": "boolean"
                        },
                        "mine": {
                          "type": "boolean"
                        },
                        "definition": {
                          "type": "object",
                          "properties": {
                            "mode": {
                              "type": "string",
                              "enum": [
                                "variants",
                                "products"
                              ]
                            },
                            "viewType": {
                              "default": "grid",
                              "type": "string",
                              "enum": [
                                "grid",
                                "gallery"
                              ]
                            },
                            "columns": {
                              "default": [],
                              "maxItems": 150,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "key": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 100
                                  },
                                  "width": {
                                    "type": "integer",
                                    "minimum": 40,
                                    "maximum": 1200
                                  },
                                  "hidden": {
                                    "type": "boolean"
                                  }
                                },
                                "required": [
                                  "key"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "sort": {
                              "type": "object",
                              "properties": {
                                "field": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 100
                                },
                                "direction": {
                                  "default": "asc",
                                  "type": "string",
                                  "enum": [
                                    "asc",
                                    "desc"
                                  ]
                                }
                              },
                              "required": [
                                "field",
                                "direction"
                              ],
                              "additionalProperties": false
                            },
                            "filter": {
                              "maxItems": 20,
                              "type": "array",
                              "items": {
                                "anyOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "field": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 100,
                                        "description": "A field key, or a built-in: name, sku, price, status, family, tags, weight, available, created_at, updated_at, has_picture, has_shipping_package, has_barcode (booleans: op is, value true or false), supplier_sku (the preferred supplier’s SKU)."
                                      },
                                      "op": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 30,
                                        "description": "Text: contains, equals, starts_with. Numbers, money, measurements: eq, neq, lt, lte, gt, gte, between. Dates: before, after, on, between, within_next_days, within_last_days. Single select: is_any_of, is_none_of. Multi select and tags: has_any, has_all, has_none. Boolean: is. Relationships: has_related. Any: is_empty, is_not_empty."
                                      },
                                      "value": {
                                        "description": "Option labels or IDs for selects, and family names or IDs for family; \"2 kg\" for measurements; [from, to] for between."
                                      }
                                    },
                                    "required": [
                                      "field",
                                      "op"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "any": {
                                        "minItems": 1,
                                        "maxItems": 20,
                                        "type": "array",
                                        "items": {
                                          "type": "object",
                                          "properties": {
                                            "field": {
                                              "type": "string",
                                              "minLength": 1,
                                              "maxLength": 100,
                                              "description": "A field key, or a built-in: name, sku, price, status, family, tags, weight, available, created_at, updated_at, has_picture, has_shipping_package, has_barcode (booleans: op is, value true or false), supplier_sku (the preferred supplier’s SKU)."
                                            },
                                            "op": {
                                              "type": "string",
                                              "minLength": 1,
                                              "maxLength": 30,
                                              "description": "Text: contains, equals, starts_with. Numbers, money, measurements: eq, neq, lt, lte, gt, gte, between. Dates: before, after, on, between, within_next_days, within_last_days. Single select: is_any_of, is_none_of. Multi select and tags: has_any, has_all, has_none. Boolean: is. Relationships: has_related. Any: is_empty, is_not_empty."
                                            },
                                            "value": {
                                              "description": "Option labels or IDs for selects, and family names or IDs for family; \"2 kg\" for measurements; [from, to] for between."
                                            }
                                          },
                                          "required": [
                                            "field",
                                            "op"
                                          ],
                                          "additionalProperties": false
                                        }
                                      }
                                    },
                                    "required": [
                                      "any"
                                    ],
                                    "additionalProperties": false
                                  }
                                ]
                              },
                              "description": "All items must match; an {any: [...]} item matches when one of its conditions does."
                            },
                            "search": {
                              "type": "string",
                              "maxLength": 200
                            },
                            "density": {
                              "default": "compact",
                              "type": "string",
                              "enum": [
                                "compact",
                                "comfortable"
                              ]
                            }
                          },
                          "required": [
                            "mode",
                            "viewType",
                            "columns",
                            "density"
                          ],
                          "additionalProperties": false
                        },
                        "version": {
                          "type": "number"
                        },
                        "updatedAt": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "shared",
                        "mine",
                        "definition",
                        "version",
                        "updatedAt"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "views"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
