                      "enum": [
                        "variants",
                        "products"
                      ]
                    },
                    "viewType": {
                      "default": "grid",
                      "type": "string",
                      "enum": [
                        "grid",
                        "gallery"
                      ]
                    },
                    "columns": {
                      "default": [],
                      "maxItems": 150,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "width": {
                            "type": "integer",
