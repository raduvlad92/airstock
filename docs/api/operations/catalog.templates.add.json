{
  "/api/v1/shops/{shopId}/catalog/templates": {
    "post": {
      "operationId": "catalog.templates.add",
      "summary": "Add a starter family: apparel, furniture, food, or spare parts",
      "description": "Copies the template into the shop as ordinary fields and a family, which you can then change. A field whose key already exists with the same type is reused, and missing options are added to it.",
      "x-permission": "catalog.schema.manage",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.template.added",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "template": {
                  "type": "string",
                  "enum": [
                    "apparel",
                    "furniture",
                    "food",
                    "spare_parts"
                  ]
                }
              },
              "required": [
                "template"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "family": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "templateKey": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "active",
                          "archived"
                        ]
                      },
                      "version": {
                        "type": "number"
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "fieldId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "key": {
                              "type": "string"
                            },
                            "required": {
                              "type": "boolean"
                            },
                            "position": {
                              "type": "number"
                            },
                            "group": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "fieldId",
                            "key",
                            "required",
                            "position",
                            "group"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "suggestedOptions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "name",
                            "values"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "description",
                      "templateKey",
                      "status",
                      "version",
                      "fields",
                      "suggestedOptions"
                    ],
                    "additionalProperties": false
                  },
                  "createdFields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reusedFields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "family",
                  "createdFields",
                  "reusedFields"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
