{
  "/api/v1/shops/{shopId}/products/{productId}/variants/generate": {
    "post": {
      "operationId": "catalog.variants.generate",
      "summary": "Preview or create variants for every combination of option values",
      "description": "Give the options and values to combine (including the product’s existing options) and a SKU pattern such as \"TS-{color}-{size}\". With mode \"preview\" (the default) nothing is created: you get each combination, its SKU, and any duplicates. Run again with mode \"create\" to create the missing variants. A product’s single default variant keeps its ID, SKU, stock, and history and takes the first combination.",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.variants.generated",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "options": {
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "description": "An existing option, to rename or reorder it.",
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "Such as Size or Colour."
                      },
                      "values": {
                        "minItems": 1,
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            },
                            {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 100
                                }
                              },
                              "required": [
                                "label"
                              ]
                            }
                          ]
                        },
                        "description": "Value labels in order, or {id, label} to rename an existing value."
                      }
                    },
                    "required": [
                      "name",
                      "values"
                    ]
                  },
                  "description": "Up to 3 options, in order."
                },
                "skuPattern": {
                  "description": "Placeholders are option names in braces. Without one, SKUs are the base SKU plus the values.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "price": {
                  "description": "Price for new variants; defaults to the default variant’s.",
                  "type": "string",
                  "maxLength": 30
                },
                "mode": {
                  "default": "preview",
                  "type": "string",
                  "enum": [
                    "preview",
                    "create"
                  ]
                }
              },
              "required": [
                "options"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "preview",
                      "create"
                    ]
                  },
                  "combinations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "optionValues": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "sku": {
                          "type": "string"
                        },
                        "variantId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "existing",
                            "kept",
                            "new"
                          ],
                          "description": "kept: the default variant takes this combination."
                        },
                        "duplicate": {
                          "type": "boolean",
                          "description": "The SKU is already used, or repeats within this set."
                        }
                      },
                      "required": [
                        "optionValues",
                        "sku",
                        "variantId",
                        "state",
                        "duplicate"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "created": {
                    "type": "number"
                  },
                  "item": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "product": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "name": {
                                "type": "string"
                              },
                              "description": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "draft",
                                  "active",
                                  "archived",
                                  "sold"
                                ],
                                "description": "sold: a one-of-a-kind item that was fulfilled; it is active again if it returns."
                              },
                              "family": {
                                "anyOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                      },
                                      "name": {
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "id",
                                      "name"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "tags": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "weight": {},
                              "dimensions": {},
                              "version": {
                                "type": "number"
                              },
                              "createdAt": {
                                "type": "string"
                              },
                              "updatedAt": {
                                "type": "string"
                              },
                              "fields": {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string"
                                },
                                "additionalProperties": {
                                  "type": "object",
                                  "properties": {
                                    "value": {},
                                    "display": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    },
                                    "source": {
                                      "type": "string",
                                      "enum": [
                                        "own",
                                        "inherited",
                                        "cleared",
                                        "none"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "value",
                                    "display",
                                    "source"
                                  ],
                                  "additionalProperties": false
                                },
                                "description": "Custom fields by key."
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "description",
                              "status",
                              "family",
                              "tags",
                              "weight",
                              "dimensions",
                              "version",
                              "createdAt",
                              "updatedAt",
                              "fields"
                            ],
                            "additionalProperties": false
                          },
                          "options": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "position": {
                                  "type": "number"
                                },
                                "values": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                      },
                                      "label": {
                                        "type": "string"
                                      },
                                      "position": {
                                        "type": "number"
                                      }
                                    },
                                    "required": [
                                      "id",
                                      "label",
                                      "position"
                                    ],
                                    "additionalProperties": false
                                  }
                                }
                              },
                              "required": [
                                "id",
                                "name",
                                "position",
                                "values"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "variants": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "sku": {
                                  "type": "string"
                                },
                                "title": {
                                  "type": "string",
                                  "description": "Option values, such as \"Black / M\"; empty for a single variant."
                                },
                                "optionValues": {
                                  "type": "object",
                                  "propertyNames": {
                                    "type": "string"
                                  },
                                  "additionalProperties": {
                                    "type": "string"
                                  },
                                  "description": "Option name → value label."
                                },
                                "optionValueIds": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                  }
                                },
                                "price": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "baseUnit": {
