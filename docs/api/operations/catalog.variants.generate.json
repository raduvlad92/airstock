                                        ]
                                      }
                                    },
                                    "required": [
                                      "value",
                                      "display",
                                      "source"
                                    ],
                                    "additionalProperties": false
                                  },
                                  "description": "Custom fields by key."
                                }
                              },
                              "required": [
                                "id",
                                "sku",
                                "title",
                                "optionValues",
                                "optionValueIds",
                                "price",
                                "baseUnit",
                                "quantityScale",
                                "trackingMode",
                                "oneOfAKind",
                                "sellByMarginDays",
                                "status",
                                "isDefault",
                                "version",
                                "weight",
                                "dimensions",
                                "fields"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "incoming": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "field": {
                                  "type": "string"
                                },
                                "relationKind": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "sourceType": {
                                  "type": "string",
                                  "enum": [
                                    "product",
                                    "variant"
                                  ]
                                },
                                "sourceId": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
