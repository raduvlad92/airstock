                                  "type": "number"
                                },
                                "trackingMode": {
                                  "type": "string"
                                },
                                "oneOfAKind": {
                                  "type": "boolean"
                                },
                                "sellByMarginDays": {
                                  "type": "number"
                                },
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "active",
                                    "archived"
                                  ]
                                },
                                "isDefault": {
                                  "type": "boolean"
                                },
                                "version": {
                                  "type": "number"
                                },
                                "weight": {
                                  "type": "object",
                                  "properties": {
                                    "value": {},
                                    "display": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    },
                                    "source": {
                                      "type": "string",
                                      "enum": [
                                        "own",
                                        "inherited",
                                        "cleared",
                                        "none"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "value",
                                    "display",
                                    "source"
                                  ],
                                  "additionalProperties": false
                                },
                                "dimensions": {
                                  "type": "object",
                                  "properties": {
                                    "value": {},
                                    "display": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    },
                                    "source": {
                                      "type": "string",
                                      "enum": [
                                        "own",
                                        "inherited",
                                        "cleared",
                                        "none"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "value",
                                    "display",
                                    "source"
                                  ],
                                  "additionalProperties": false
                                },
                                "fields": {
                                  "type": "object",
                                  "propertyNames": {
                                    "type": "string"
                                  },
                                  "additionalProperties": {
                                    "type": "object",
                                    "properties": {
                                      "value": {},
                                      "display": {
                                        "type": [
                                          "string",
                                          "null"
                                        ]
                                      },
                                      "source": {
                                        "type": "string",
                                        "enum": [
                                          "own",
                                          "inherited",
                                          "cleared",
