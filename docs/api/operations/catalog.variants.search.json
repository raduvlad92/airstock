{
  "/api/v1/shops/{shopId}/variants": {
    "get": {
      "operationId": "catalog.variants.search",
      "summary": "Find variants by SKU or name",
      "x-permission": "catalog.read",
      "x-connection-scope": "catalog:read",
      "x-audit-action": "catalog.variants.searched",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "sku",
          "in": "query",
          "required": false,
          "schema": {
            "description": "Exact SKU, matched after normalization.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        {
          "name": "query",
          "in": "query",
          "required": false,
          "schema": {
            "description": "Text found in the product name or SKU.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "default": 25,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        {
          "name": "after",
          "in": "query",
          "required": false,
          "schema": {
            "description": "Cursor from the previous page.",
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "variants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "variantId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "productId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "productName": {
                          "type": "string"
                        },
                        "sku": {
                          "type": "string"
                        },
                        "price": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "baseUnit": {
                          "type": "string"
                        },
                        "quantityScale": {
                          "type": "number"
                        },
                        "status": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "variantId",
                        "productId",
                        "productName",
                        "sku",
                        "price",
                        "baseUnit",
                        "quantityScale",
                        "status"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "nextCursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "variants",
                  "nextCursor"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
