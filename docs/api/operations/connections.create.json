{
  "/api/v1/shops/{shopId}/connections": {
    "post": {
      "operationId": "connections.create",
      "summary": "Approve an AI or OAuth connection",
      "description": "The consent step: binds a new connection to this shop with the chosen scopes. The first request with the issued token binds it to that client (plan Section 7.2) and revokes your earlier connections from the same client in this shop; a connection no client uses within 10 minutes expires.",
      "x-permission": "shop.read",
      "x-connection-scope": "session",
      "x-audit-action": "connection.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "scopes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "shop:read",
                      "catalog:read",
                      "catalog:write",
                      "storage:read",
                      "storage:write",
                      "inventory:read",
                      "inventory:write",
                      "activity:read"
                    ]
                  }
                }
              },
              "required": [
                "scopes"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "grantId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "grantId",
                  "scopes"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
