{
  "/api/v1/shops/{shopId}/api-credentials": {
    "post": {
      "operationId": "credentials.create",
      "summary": "Create an API credential",
      "description": "Creates a scoped credential that acts for you, never beyond your own permissions and locations. The token is shown once.",
      "x-permission": "credentials.manage",
      "x-connection-scope": "session",
      "x-audit-action": "credential.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "scopes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "shop:read",
                      "catalog:read",
                      "catalog:write",
                      "storage:read",
                      "storage:write",
                      "inventory:read",
                      "inventory:write",
                      "activity:read",
                      "webhooks:manage"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "scopes"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "credentialId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "token": {
                    "type": "string"
                  }
                },
                "required": [
                  "credentialId",
                  "name",
                  "scopes",
                  "token"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
