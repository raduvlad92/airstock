{
  "/api/v1/shops/{shopId}/api-credentials/{credentialId}/revoke": {
    "post": {
      "operationId": "credentials.revoke",
      "summary": "Revoke an API credential",
      "x-permission": "credentials.manage",
      "x-connection-scope": "session",
      "x-audit-action": "credential.revoked",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "credentialId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "credentialId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "status": {
                    "type": "string",
                    "const": "revoked"
                  }
                },
                "required": [
                  "credentialId",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
