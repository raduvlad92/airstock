{
  "/api/v1/shops/{shopId}/exports": {
    "get": {
      "operationId": "exports.list",
      "summary": "List recent exports",
      "x-permission": "exports.run",
      "x-connection-scope": "catalog:read",
      "x-audit-action": "catalog.exports.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "exports": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "exportId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "catalog",
                            "activity",
                            "lot_trace"
                          ],
                          "description": "catalog: products or variants; activity: the activity history; lot_trace: one lot’s trace."
                        },
                        "status": {
                          "type": "string"
                        },
                        "rowCount": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "error": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "completedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "downloadUntil": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "downloadPath": {
                          "description": "An API path, not a link to share: the file downloads in the dashboard (Products, then Import, Recent exports) while signed in.",
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "exportId",
                        "kind",
                        "status",
                        "rowCount",
                        "error",
                        "createdAt",
                        "completedAt",
                        "downloadUntil",
                        "downloadPath"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "exports"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
