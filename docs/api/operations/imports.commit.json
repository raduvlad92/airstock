{
  "/api/v1/shops/{shopId}/imports/{importId}/commit": {
    "post": {
      "operationId": "imports.commit",
      "summary": "Commit a previewed import",
      "description": "Writes the valid rows of the last preview in chunks, as a job; rows with errors are skipped. Opening stock is received with the reason \"opening stock\". Packs, barcodes, and supplier items are checked again as each chunk is written. Needs catalog.write, which saving packs and supplier items needs too. Follow progress with get_import.",
      "x-permission": "imports.run",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.import.committed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "importId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "import": {
                    "type": "object",
                    "properties": {
                      "importId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "fileName": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "header": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "mapping": {
                        "anyOf": [
                          {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "rowCount": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "counts": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "number"
                        }
                      },
                      "checkpoint": {
                        "type": "number"
                      },
                      "error": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "completedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "importId",
                      "fileName",
                      "status",
                      "header",
                      "mapping",
                      "rowCount",
                      "counts",
                      "checkpoint",
                      "error",
                      "createdAt",
                      "completedAt"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "import"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
