{
  "/api/v1/shops/{shopId}/imports": {
    "post": {
      "operationId": "imports.create",
      "summary": "Start a CSV import",
      "description": "Creates the import and returns where to upload the file (PUT, UTF-8 CSV, comma or semicolon, up to 20 MB and 50,000 rows).",
      "x-permission": "imports.run",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.import.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "fileName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "fileName"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "importId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "uploadPath": {
                    "type": "string"
                  }
                },
                "required": [
                  "importId",
                  "uploadPath"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
