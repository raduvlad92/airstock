{
  "/api/v1/shops/{shopId}/imports": {
    "get": {
      "operationId": "imports.list",
      "summary": "List recent imports",
      "x-permission": "catalog.read",
      "x-connection-scope": "catalog:read",
      "x-audit-action": "catalog.imports.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "imports": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "importId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "fileName": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "header": {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "mapping": {
                          "anyOf": [
                            {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {
                                "type": "string"
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "rowCount": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "counts": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "number"
                          }
                        },
                        "checkpoint": {
                          "type": "number"
                        },
                        "error": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "completedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "importId",
                        "fileName",
                        "status",
                        "header",
                        "mapping",
                        "rowCount",
                        "counts",
                        "checkpoint",
                        "error",
                        "createdAt",
                        "completedAt"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "imports"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
