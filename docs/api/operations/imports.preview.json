{
  "/api/v1/shops/{shopId}/imports/{importId}/preview": {
    "post": {
      "operationId": "imports.preview",
      "summary": "Map an import’s columns and validate every row",
      "description": "Without a mapping, returns the columns and a suggested mapping. With one, validates every row without writing: creates (new SKUs), updates (matched by SKU), errors, and likely duplicates. Targets: product, name, description, status, family, tags, sku, barcode, supplier, supplier_sku, price, weight, dimensions, field:<key>, option:<name>, pack:<name>, pack_barcode:<name>, stock:<locationId>, ignore. supplier names an existing supplier (by name, any case); supplier_sku needs a supplier in the same row and sets that supplier item’s SKU, never its cost. pack:<name> is the quantity of base units in a top-level pack of that name, created or changed; pack_barcode:<name> adds a barcode to it.",
      "x-permission": "imports.run",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.import.previewed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "importId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "mapping": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "delimiter": {
                  "type": "string",
                  "enum": [
                    ",",
                    ";"
                  ]
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "import": {
                    "type": "object",
                    "properties": {
                      "importId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "fileName": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "header": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "mapping": {
                        "anyOf": [
                          {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "rowCount": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "counts": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "number"
                        }
                      },
                      "checkpoint": {
                        "type": "number"
                      },
                      "error": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "completedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "importId",
                      "fileName",
                      "status",
                      "header",
                      "mapping",
                      "rowCount",
                      "counts",
                      "checkpoint",
                      "error",
                      "createdAt",
                      "completedAt"
                    ],
                    "additionalProperties": false
                  },
                  "suggestedMapping": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "packNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Pack names the shop uses, for pack:<name> and pack_barcode:<name> targets."
                  },
                  "problems": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rowNumber": {
                          "type": "number"
                        },
                        "action": {
                          "type": "string"
                        },
                        "errors": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "warnings": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "rowNumber",
                        "action",
                        "errors",
                        "warnings"
                      ],
                      "additionalProperties": false
                    },
                    "description": "The first 100 rows with errors or warnings."
                  }
                },
                "required": [
                  "import",
                  "suggestedMapping",
                  "packNames",
                  "problems"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
