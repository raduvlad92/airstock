{
  "/api/v1/shops/{shopId}/imports/{importId}/uploaded": {
    "post": {
      "operationId": "imports.upload.record",
      "summary": "Record that an import file was uploaded",
      "description": "Called by the upload route after the file is stored; checks that the import is still waiting for its file.",
      "x-permission": "imports.run",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "catalog.import.uploaded",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "importId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20971520
                }
              },
              "required": [
                "sizeBytes"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "importId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "status": {
                    "type": "string"
                  }
                },
                "required": [
                  "importId",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
