{
  "/api/v1/shops/{shopId}/adjustments": {
    "post": {
      "operationId": "inventory.adjustments.create",
      "summary": "Adjust stock up or down with a reason",
      "description": "Use this to correct stock at one location with a reason: damage, loss or theft, found, write-off, sample, supplier return, count correction, or other (with a note). Units removed leave valuation at the moving average; units added come in at the average. Lot-tracked items name the lot; serial-tracked items name the serials. If a removal leaves fewer units than are reserved, the error lists the claims: retry with reservationChoices. Not for counted totals (use action \"count\"), receiving deliveries (receive_stock), or moving stock (transfer_stock).",
      "x-permission": "inventory.adjust",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "inventory.adjustment.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "locationId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "The shelf (a location without sub-locations)."
                },
                "condition": {
                  "default": "sellable",
                  "type": "string",
                  "enum": [
                    "sellable",
                    "quarantine",
                    "damaged",
                    "repair",
                    "supplier_return"
                  ]
                },
                "adjustmentReason": {
                  "type": "string",
                  "enum": [
                    "count_correction",
                    "damage",
                    "loss_or_theft",
                    "found",
                    "write_off",
                    "sample",
                    "supplier_return",
                    "other"
                  ]
                },
                "adjustments": {
                  "minItems": 1,
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "variantId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "add",
                          "remove"
                        ]
                      },
                      "quantity": {
                        "description": "Base units, or packs with packId. Serial-tracked items give serials instead.",
                        "type": "string",
                        "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$"
                      },
                      "packId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "lotCode": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "A lot or batch code. Codes are unique per variant, ignoring case and extra spaces."
                      },
                      "serials": {
                        "minItems": 1,
                        "maxItems": 500,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      }
                    },
                    "required": [
                      "variantId",
                      "direction"
                    ]
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "description": "Anything worth keeping with the change; kept in the history."
                },
                "reservationChoices": {
                  "description": "When a change leaves fewer units than are reserved: per claim, release it or move it elsewhere. The error below_reserved lists the claims.",
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "allocationId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "release",
                          "reallocate"
                        ],
                        "description": "release frees the claim; reallocate moves it to other free stock."
                      },
                      "quantity": {
                        "description": "Leave out for the whole claim.",
                        "type": "string",
                        "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$"
                      }
                    },
                    "required": [
                      "allocationId",
                      "action"
                    ]
                  }
                }
              },
              "required": [
                "locationId",
                "adjustmentReason",
                "adjustments"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "variantId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "locationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "condition": {
                          "type": "string"
                        },
                        "lotId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "serialId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "delta": {
                          "type": "string",
                          "description": "Signed base units."
                        }
                      },
                      "required": [
                        "variantId",
                        "locationId",
                        "condition",
                        "lotId",
                        "serialId",
                        "delta"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "released": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "allocationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "reservationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "quantity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "allocationId",
                        "reservationId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "reallocated": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "allocationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "reservationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "quantity": {
                          "type": "string"
                        },
                        "to": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          }
                        }
                      },
                      "required": [
                        "allocationId",
                        "reservationId",
                        "quantity",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "shortagesFilled": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "reservationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "quantity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "reservationId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "costVisible": {
                    "type": "boolean"
                  },
                  "unitCosts": {
                    "anyOf": [
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Per variant, the cost the change used; needs costs.read."
                  },
                  "operationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "changes",
                  "released",
                  "reallocated",
                  "shortagesFilled",
                  "costVisible",
                  "unitCosts",
                  "operationId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
