{
  "/api/v1/shops/{shopId}/availability": {
    "get": {
      "operationId": "inventory.availability.get",
      "summary": "Get stock and availability for a variant",
      "description": "Use this for \"how many do I have\" questions: on hand, reserved, available, in transit, quarantined, damaged, expired, and shortage for one variant, per location, condition, lot, and serial, with totals. Filter by locationId (with its sub-locations) or warehouseId. Totals cover only the locations you can access; `partial` says when that is a subset. The average cost and value are included with costs.read for members with access to every location.",
      "x-permission": "inventory.read",
      "x-connection-scope": "inventory:read",
      "x-audit-action": "inventory.availability.viewed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "variantId",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        {
          "name": "locationId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        {
          "name": "warehouseId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "variantId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "sku": {
                    "type": "string"
                  },
                  "trackingMode": {
                    "type": "string"
                  },
                  "partial": {
                    "type": "boolean"
                  },
                  "totals": {
                    "type": "object",
                    "properties": {
                      "onHand": {
                        "type": "string",
                        "description": "Physically at locations, in every condition (not in transit)."
                      },
                      "sellableOnHand": {
                        "type": "string"
                      },
                      "reserved": {
                        "type": "string"
                      },
                      "available": {
                        "type": "string",
                        "description": "Never below zero; shortages are reported separately."
                      },
                      "quarantined": {
                        "type": "string"
                      },
                      "damaged": {
                        "type": "string"
                      },
                      "repair": {
                        "type": "string"
                      },
                      "supplierReturn": {
                        "type": "string"
                      },
                      "expired": {
                        "type": "string",
                        "description": "On hand in lots past their sellable date."
                      },
                      "inTransit": {
                        "type": "string"
                      },
                      "ownedTotal": {
                        "type": "string",
                        "description": "On hand plus in transit."
                      },
                      "shortage": {
                        "type": "string",
                        "description": "Demand from accepted orders that no stock covers yet (whole shop)."
                      },
                      "onOrder": {
                        "type": "string",
                        "description": "Still expected on sent purchase orders to these warehouses. Never sellable."
                      }
                    },
                    "required": [
                      "onHand",
                      "sellableOnHand",
                      "reserved",
                      "available",
                      "quarantined",
                      "damaged",
                      "repair",
                      "supplierReturn",
                      "expired",
                      "inTransit",
                      "ownedTotal",
                      "shortage",
                      "onOrder"
                    ],
                    "additionalProperties": false
                  },
                  "positions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "positionId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "locationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "locationPath": {
                          "type": "string"
                        },
                        "warehouseId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "condition": {
                          "type": "string",
                          "enum": [
                            "sellable",
                            "quarantine",
                            "damaged",
                            "repair",
                            "supplier_return"
                          ]
                        },
                        "lotId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "lotCode": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "expiresOn": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "lotExpired": {
                          "type": "boolean"
                        },
                        "serial": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "inTransit": {
                          "type": "boolean"
                        },
                        "sellable": {
                          "type": "boolean"
                        },
                        "onHand": {
                          "type": "string"
                        },
                        "reserved": {
                          "type": "string"
                        },
                        "available": {
                          "type": "string"
                        },
                        "version": {
                          "type": "number",
                          "description": "The position version; a count of what was read here sends it back."
                        }
                      },
                      "required": [
                        "positionId",
                        "locationId",
                        "locationPath",
                        "warehouseId",
                        "condition",
                        "lotId",
                        "lotCode",
                        "expiresOn",
                        "lotExpired",
                        "serial",
                        "inTransit",
                        "sellable",
                        "onHand",
                        "reserved",
                        "available",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "onOrder": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "purchaseOrderId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "number": {
                          "type": "string"
                        },
                        "warehouseId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "expectedOn": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "quantity": {
                          "type": "string",
                          "description": "Base units still open on the order’s lines."
                        }
                      },
                      "required": [
                        "purchaseOrderId",
                        "number",
                        "warehouseId",
                        "expectedOn",
                        "quantity"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Open purchase orders for this variant, by destination (PRD 5.3)."
                  },
                  "costVisible": {
                    "type": "boolean"
                  },
                  "cost": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "averageCost": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "defaultCost": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "ownedQuantity": {
                            "type": "string"
                          },
                          "value": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "averageCost",
                          "defaultCost",
                          "ownedQuantity",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Shop-wide moving average and value of owned stock; needs costs.read and access to every location."
                  }
                },
                "required": [
                  "variantId",
                  "sku",
                  "trackingMode",
                  "partial",
                  "totals",
                  "positions",
                  "onOrder",
                  "costVisible",
                  "cost"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
