{
  "/api/v1/shops/{shopId}/condition-changes": {
    "post": {
      "operationId": "inventory.condition_changes.create",
      "summary": "Move units between conditions at one location",
      "description": "Use this to change the condition of units without changing on hand, for example quarantine to sellable after a check, or sellable to damaged. Only free units move (reserved ones must be released or reallocated first). Units moved to sellable fill open order shortages first. Lot-tracked items name the lot; serial-tracked items name the serials. Leave out quantity to move every free unit of the item in that condition.",
      "x-permission": "inventory.adjust",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "inventory.condition.changed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "locationId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "fromCondition": {
                  "type": "string",
                  "enum": [
                    "sellable",
                    "quarantine",
                    "damaged",
                    "repair",
                    "supplier_return"
                  ]
                },
                "toCondition": {
                  "type": "string",
                  "enum": [
                    "sellable",
                    "quarantine",
                    "damaged",
                    "repair",
                    "supplier_return"
                  ]
                },
                "items": {
                  "minItems": 1,
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "variantId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "quantity": {
                        "type": "string",
                        "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$",
                        "description": "Decimal string greater than zero, at most 14 integer digits and 6 decimal places."
                      },
                      "packId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "lotCode": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "description": "A lot or batch code. Codes are unique per variant, ignoring case and extra spaces."
                      },
                      "serials": {
                        "minItems": 1,
                        "maxItems": 500,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      }
                    },
                    "required": [
                      "variantId"
                    ]
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "description": "Anything worth keeping with the change; kept in the history."
                }
              },
              "required": [
                "locationId",
                "fromCondition",
                "toCondition",
                "items"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "moved": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "variantId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "lotId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "serialId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "quantity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "variantId",
                        "lotId",
                        "serialId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "shortagesFilled": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "reservationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "quantity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "reservationId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "operationId",
                  "moved",
                  "shortagesFilled"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
