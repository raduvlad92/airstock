{
  "/api/v1/shops/{shopId}/moves": {
    "post": {
      "operationId": "inventory.moves.create",
      "summary": "Move stock from one shelf to another inside a warehouse, now",
      "description": "Use this for \"move 2 of X from shelf A1 to B2\": one command that holds, dispatches, and receives together, recorded as a completed transfer. Both locations must be in the same warehouse and in your location scope; the destination must be a shelf without sub-locations. Not for sending stock to another warehouse (create a transfer) or for changing a condition (use adjust_stock).",
      "x-permission": "inventory.transfer",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "inventory.move.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "fromLocationId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "Stock is taken from this location and its sub-locations."
                },
                "toLocationId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "The shelf the units go to."
                },
                "lines": {
                  "minItems": 1,
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "variantId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "quantity": {
                        "type": "string",
                        "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$",
                        "description": "Base units, or packs when packId is set."
                      },
                      "packId": {
                        "description": "Enter the quantity in one of the variant’s packs.",
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "lotCode": {
                        "description": "Move only this lot.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "serials": {
                        "description": "Serial-tracked variants: exactly these serials.",
                        "minItems": 1,
                        "maxItems": 500,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      },
                      "condition": {
                        "default": "sellable",
                        "description": "Which stock to move; transfers keep the condition.",
                        "type": "string",
                        "enum": [
                          "sellable",
                          "quarantine",
                          "damaged",
                          "repair",
                          "supplier_return"
                        ]
                      }
                    },
                    "required": [
                      "variantId",
                      "quantity"
                    ]
                  }
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "Why, in a few words; kept in the history."
                }
              },
              "required": [
                "fromLocationId",
                "toLocationId",
                "lines"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operationId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The stock operation this step recorded, if it moved stock."
                  },
                  "transfer": {
                    "type": "object",
                    "properties": {
                      "transferId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "transfer",
                          "move"
                        ]
                      },
                      "reference": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "trackingReference": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "note": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "draft",
                          "ready",
                          "partially_dispatched",
                          "dispatched",
                          "partially_received",
                          "received",
                          "cancelled",
                          "exception"
                        ]
                      },
                      "from": {
                        "type": "object",
                        "properties": {
                          "locationId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "path": {
                            "type": "string"
                          },
                          "warehouseId": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "locationId",
                          "path",
                          "warehouseId"
                        ],
                        "additionalProperties": false
                      },
                      "to": {
                        "type": "object",
                        "properties": {
                          "locationId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "path": {
                            "type": "string"
                          },
                          "warehouseId": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "locationId",
                          "path",
                          "warehouseId"
                        ],
                        "additionalProperties": false
                      },
                      "exception": {
                        "type": "object",
                        "properties": {
                          "open": {
                            "type": "boolean"
                          },
                          "note": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "open",
                          "note"
                        ],
                        "additionalProperties": false
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "readyAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "closedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "version": {
                        "type": "number"
                      },
                      "totals": {
                        "type": "object",
                        "properties": {
                          "planned": {
                            "type": "string"
                          },
                          "cancelled": {
                            "type": "string"
                          },
                          "dispatched": {
                            "type": "string"
                          },
                          "received": {
                            "type": "string"
                          },
                          "resolved": {
                            "type": "string",
                            "description": "Settled by an exception resolution (lost, damaged, short)."
                          },
                          "held": {
                            "type": "string",
                            "description": "Still held at the source, waiting for dispatch."
                          },
                          "inTransit": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "planned",
                          "cancelled",
                          "dispatched",
                          "received",
                          "resolved",
                          "held",
                          "inTransit"
                        ],
                        "additionalProperties": false
                      },
                      "lines": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "planned": {
                              "type": "string"
                            },
                            "cancelled": {
                              "type": "string"
                            },
                            "dispatched": {
                              "type": "string"
                            },
                            "received": {
                              "type": "string"
                            },
                            "resolved": {
                              "type": "string",
                              "description": "Settled by an exception resolution (lost, damaged, short)."
                            },
                            "held": {
                              "type": "string",
                              "description": "Still held at the source, waiting for dispatch."
                            },
                            "inTransit": {
                              "type": "string"
                            },
                            "lineId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "variantId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "sku": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "condition": {
                              "type": "string",
                              "enum": [
                                "sellable",
                                "quarantine",
                                "damaged",
                                "repair",
                                "supplier_return"
                              ]
                            },
                            "lotCode": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "serials": {
                              "anyOf": [
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "description": "Serials named when the line was made."
                            },
                            "entered": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "packId": {
                                      "type": "string",
                                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                    },
                                    "packName": {
                                      "type": "string"
                                    },
                                    "quantity": {
                                      "type": "string"
                                    },
                                    "factor": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "packId",
                                    "packName",
                                    "quantity",
                                    "factor"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "reservationId": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "description": "The transfer hold at the source."
                            },
                            "inTransitUnits": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "lotCode": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "serial": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "quantity": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "lotCode",
                                  "serial",
                                  "quantity"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "planned",
                            "cancelled",
                            "dispatched",
                            "received",
                            "resolved",
                            "held",
                            "inTransit",
                            "lineId",
                            "variantId",
                            "sku",
                            "name",
                            "condition",
                            "lotCode",
                            "serials",
                            "entered",
                            "reservationId",
                            "inTransitUnits"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "transferId",
                      "kind",
                      "reference",
                      "trackingReference",
                      "note",
                      "status",
                      "from",
                      "to",
                      "exception",
                      "createdAt",
                      "readyAt",
                      "closedAt",
                      "version",
                      "totals",
                      "lines"
                    ],
                    "additionalProperties": false
                  },
                  "shortagesFilled": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "reservationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "quantity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "reservationId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "operationId",
                  "transfer",
                  "shortagesFilled"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
