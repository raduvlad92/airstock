{
  "/api/v1/shops/{shopId}/operations/{operationId}/reverse": {
    "post": {
      "operationId": "inventory.operations.reverse",
      "summary": "Reverse an adjustment, count, or condition change",
      "description": "Use this to undo a stock correction made by mistake. Records a new operation linked to the original that puts every position back (units removed come back at the cost they left with; units added leave at the moving average). An operation can be reversed once. Receipts, fulfillments, transfers, and returns have their own steps and cannot be reversed here.",
      "x-permission": "inventory.adjust",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "inventory.operation.reversed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "operationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "description": "Anything worth keeping with the change; kept in the history."
                },
                "reservationChoices": {
                  "description": "When a change leaves fewer units than are reserved: per claim, release it or move it elsewhere. The error below_reserved lists the claims.",
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "allocationId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "release",
                          "reallocate"
                        ],
                        "description": "release frees the claim; reallocate moves it to other free stock."
                      },
                      "quantity": {
                        "description": "Leave out for the whole claim.",
                        "type": "string",
                        "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$"
                      }
                    },
                    "required": [
                      "allocationId",
                      "action"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "variantId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "locationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "condition": {
                          "type": "string"
                        },
                        "lotId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "serialId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "delta": {
                          "type": "string",
                          "description": "Signed base units."
                        }
                      },
                      "required": [
                        "variantId",
                        "locationId",
                        "condition",
                        "lotId",
                        "serialId",
                        "delta"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "released": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "allocationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "reservationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "quantity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "allocationId",
                        "reservationId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "reallocated": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "allocationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "reservationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "quantity": {
                          "type": "string"
                        },
                        "to": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          }
                        }
                      },
                      "required": [
                        "allocationId",
                        "reservationId",
                        "quantity",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "shortagesFilled": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "reservationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "quantity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "reservationId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "costVisible": {
                    "type": "boolean"
                  },
                  "unitCosts": {
                    "anyOf": [
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Per variant, the cost the change used; needs costs.read."
                  },
                  "operationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "reverses": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "changes",
                  "released",
                  "reallocated",
                  "shortagesFilled",
                  "costVisible",
                  "unitCosts",
                  "operationId",
                  "reverses"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
