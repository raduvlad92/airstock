{
  "/api/v1/shops/{shopId}/reservations": {
    "post": {
      "operationId": "inventory.reservations.create",
      "summary": "Reserve sellable stock",
      "description": "Claims sellable units for an order or other purpose without moving them. Without a location, stock is allocated across fulfillment-eligible locations in location path order. Fails if not enough is available; nothing is partly reserved.",
      "x-permission": "inventory.reserve",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "inventory.reservation.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "variantId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "quantity": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$",
                  "description": "Decimal string greater than zero, at most 14 integer digits and 6 decimal places."
                },
                "locationId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "purpose": {
                  "default": "manual",
                  "type": "string",
                  "enum": [
                    "manual",
                    "external_order"
                  ]
                },
                "externalRef": {
                  "description": "For example an external order and line ID.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "expiresInSeconds": {
                  "description": "Release automatically after this many seconds.",
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 7776000
                }
              },
              "required": [
                "variantId",
                "quantity"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reservationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "operationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "variantId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "quantity": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "const": "active"
                  },
                  "expiresAt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "allocations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "positionId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "locationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "quantity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "positionId",
                        "locationId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "reservationId",
                  "operationId",
                  "variantId",
                  "quantity",
                  "status",
                  "expiresAt",
                  "allocations"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
