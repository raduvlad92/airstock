{
  "/api/v1/shops/{shopId}/reservations": {
    "post": {
      "operationId": "inventory.reservations.create",
      "summary": "Reserve sellable stock",
      "description": "Use this to hold units for an order or another purpose without moving them. Works for a variant or a bundle (every component is reserved together). Without locationId, the shop’s allocation rule picks positions: earliest expiry first for lots, then oldest stock. Fails whole if not enough is available, unless the caller is a sales channel connector, which records a shortage instead. Expiry is optional; the shop default applies when expiresInSeconds is left out, and null means never.",
      "x-permission": "inventory.reserve",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "inventory.reservation.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "variantId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "quantity": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$",
                  "description": "Base units, or bundles for a bundle variant."
                },
                "locationId": {
                  "description": "Take stock only from this location and its sub-locations.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "lotCode": {
                  "description": "Take stock only from this lot.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "purpose": {
                  "default": "manual",
                  "type": "string",
                  "enum": [
                    "manual",
                    "external_order"
                  ]
                },
                "externalRef": {
                  "description": "For example an external order and line ID.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "channel": {
                  "description": "Which allocation rule applies; \"default\" when left out.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "expiresInSeconds": {
                  "description": "Release automatically after this many seconds; null never expires.",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 60,
                      "maximum": 7776000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "allowShortage": {
                  "description": "Connectors only: record what is short as a shortage instead of failing.",
                  "type": "boolean"
                }
              },
              "required": [
                "variantId",
                "quantity"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reservationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "operationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "variantId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "quantity": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "channel": {
                    "type": "string"
                  },
                  "expiresAt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "shortage": {
                    "type": "string"
                  },
                  "allocations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "allocationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "positionId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "locationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "lotId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "serialId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "quantity": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "allocationId",
                        "positionId",
                        "locationId",
                        "lotId",
                        "serialId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "bundle": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "bundleVersionId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "version": {
                            "type": "number"
                          },
                          "components": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "reservationId": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "variantId": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "perBundle": {
                                  "type": "string"
                                },
                                "quantity": {
                                  "type": "string"
                                },
                                "shortage": {
                                  "type": "string"
                                },
                                "allocations": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "allocationId": {
                                        "type": "string",
                                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                      },
                                      "positionId": {
                                        "type": "string",
                                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                      },
                                      "locationId": {
                                        "type": "string",
                                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                      },
                                      "lotId": {
                                        "anyOf": [
                                          {
                                            "type": "string",
                                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ]
                                      },
                                      "serialId": {
                                        "anyOf": [
                                          {
                                            "type": "string",
                                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ]
                                      },
                                      "quantity": {
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "allocationId",
                                      "positionId",
                                      "locationId",
                                      "lotId",
                                      "serialId",
                                      "quantity"
                                    ],
                                    "additionalProperties": false
                                  }
                                }
                              },
                              "required": [
                                "reservationId",
                                "variantId",
                                "perBundle",
                                "quantity",
                                "shortage",
                                "allocations"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "bundleVersionId",
                          "version",
                          "components"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "reservationId",
                  "operationId",
                  "variantId",
                  "quantity",
                  "status",
                  "channel",
                  "expiresAt",
                  "shortage",
                  "allocations",
                  "bundle"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
