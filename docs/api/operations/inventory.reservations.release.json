{
  "/api/v1/shops/{shopId}/reservations/{reservationId}/release": {
    "post": {
      "operationId": "inventory.reservations.release",
      "summary": "Release a reservation, fully or partly",
      "description": "Use this when held units are no longer needed, such as a cancelled order line. Returns reserved units to availability without moving stock: an open shortage is released first, then allocations. Without a quantity, everything still open is released.",
      "x-permission": "inventory.reserve",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "inventory.reservation.released",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "reservationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "quantity": {
                  "description": "How much to act on (bundles for a bundle reservation). Leave out for everything still open.",
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$"
                },
                "allocationId": {
                  "description": "Act on this allocation only.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reservationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "operationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "released": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "shortageReleased": {
                    "type": "string"
                  }
                },
                "required": [
                  "reservationId",
                  "operationId",
                  "released",
                  "status",
                  "shortageReleased"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
