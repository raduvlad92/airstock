{
  "/api/v1/shops/{shopId}/serials/history": {
    "get": {
      "operationId": "inventory.serials.history",
      "summary": "Show a serial’s history",
      "description": "Use this for one serialized unit (a serial or certificate number): its status, where it is now, and every step since it was received, including the order it was fulfilled for.",
      "x-permission": "inventory.read",
      "x-connection-scope": "inventory:read",
      "x-audit-action": "inventory.serial.viewed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "variantId",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        {
          "name": "serial",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "serialId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "serial": {
                    "type": "string"
                  },
                  "variantId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "sku": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "current": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "positionId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "locationId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "locationPath": {
                            "type": "string"
                          },
                          "condition": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "positionId",
                          "locationId",
                          "locationPath",
                          "condition"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "movements": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "operationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "occurredAt": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "string",
                          "description": "Positive into stock, negative out of it."
                        },
                        "locationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "locationPath": {
                          "type": "string"
                        },
                        "condition": {
                          "type": "string"
                        },
                        "reservationId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "externalRef": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "reference": {
                          "description": "The operation’s own reference.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "supplierId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "actorType": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "operationId",
                        "kind",
                        "occurredAt",
                        "quantity",
                        "locationId",
                        "locationPath",
                        "condition",
                        "reservationId",
                        "externalRef",
                        "reference",
                        "supplierId",
                        "actorType",
                        "source"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "serialId",
                  "serial",
                  "variantId",
                  "sku",
                  "status",
                  "current",
                  "movements"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
