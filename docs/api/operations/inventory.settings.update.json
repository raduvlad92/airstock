{
  "/api/v1/shops/{shopId}/stock-settings": {
    "post": {
      "operationId": "inventory.settings.update",
      "summary": "Change how receipts and reservations behave in this shop",
      "description": "Whether a receipt fills open shortages, oldest first (D6), and the expiry applied to reservations that do not set one (null: never). Connector reservations, such as Shopify orders, never expire.",
      "x-permission": "shop.manage",
      "x-connection-scope": "session",
      "x-audit-action": "inventory.settings.updated",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "fillShortagesOnReceipt": {
                  "type": "boolean"
                },
                "reservationExpiryMinutes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 129600
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fillShortagesOnReceipt": {
                    "type": "boolean"
                  },
                  "reservationExpiryMinutes": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "fillShortagesOnReceipt",
                  "reservationExpiryMinutes"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
