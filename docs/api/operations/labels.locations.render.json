{
  "/api/v1/shops/{shopId}/labels/locations": {
    "post": {
      "operationId": "labels.locations.render",
      "summary": "Resolve location labels for printing",
      "description": "Returns each location’s path, code, warehouse, and a QR code of its ID (LOC: followed by the ID), which stays valid when the location is renamed. The dashboard draws the PDF.",
      "x-permission": "storage.read",
      "x-connection-scope": "storage:read",
      "x-audit-action": "labels.locations.rendered",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "locations": {
                  "minItems": 1,
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "locationId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "copies": {
                        "default": 1,
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "locationId"
                    ]
                  }
                },
                "templateId": {
                  "description": "A saved template.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "template": {
                  "description": "A built-in template key.",
                  "type": "string",
                  "maxLength": 100
                },
                "layout": {
                  "description": "Without a template: the sheet or label size.",
                  "type": "string",
                  "enum": [
                    "a4_3x8",
                    "a4_4x10",
                    "thermal_50x25",
                    "thermal_100x50"
                  ]
                },
                "fields": {
                  "description": "Without a template: what to print.",
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 50
                  }
                }
              },
              "required": [
                "locations"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "template": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "layout": {
                        "type": "string",
                        "enum": [
                          "a4_3x8",
                          "a4_4x10",
                          "thermal_50x25",
                          "thermal_100x50"
                        ]
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "name",
                      "layout",
                      "fields"
                    ],
                    "additionalProperties": false
                  },
                  "total": {
                    "type": "number"
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "locationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "copies": {
                          "type": "number"
                        },
                        "path": {
                          "type": "string"
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "warehouse": {
                          "type": "string"
                        },
                        "barcode": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "symbology": {
                                  "type": "string",
                                  "enum": [
                                    "ean13",
                                    "ean8",
                                    "upca",
                                    "code128",
                                    "qr",
                                    "other"
                                  ]
                                },
                                "code": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "symbology",
                                "code"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Null when the record has no barcode."
                        }
                      },
                      "required": [
                        "locationId",
                        "copies",
                        "path",
                        "code",
                        "warehouse",
                        "barcode"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "template",
                  "total",
                  "labels"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
