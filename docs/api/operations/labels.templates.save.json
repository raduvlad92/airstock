{
  "/api/v1/shops/{shopId}/labels/templates": {
    "post": {
      "operationId": "labels.templates.save",
      "summary": "Save a label template",
      "description": "Without templateId, creates a template; with templateId and expectedVersion, changes it. status \"archived\" removes it from the list.",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "labels.template.saved",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "templateId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "expectedVersion": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "item",
                    "location"
                  ]
                },
                "layout": {
                  "type": "string",
                  "enum": [
                    "a4_3x8",
                    "a4_4x10",
                    "thermal_50x25",
                    "thermal_100x50"
                  ]
                },
                "fields": {
                  "minItems": 1,
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 50
                  }
                },
                "status": {
                  "default": "active",
                  "type": "string",
                  "enum": [
                    "active",
                    "archived"
                  ]
                }
              },
              "required": [
                "name",
                "kind",
                "layout",
                "fields"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "template": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Null for a built-in template."
                      },
                      "key": {
                        "description": "The built-in template’s key.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "name": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "item",
                          "location"
                        ]
                      },
                      "layout": {
                        "type": "string",
                        "enum": [
                          "a4_3x8",
                          "a4_4x10",
                          "thermal_50x25",
                          "thermal_100x50"
                        ]
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "active",
                          "archived"
                        ]
                      },
                      "version": {
                        "type": "number"
                      },
                      "updatedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "key",
                      "name",
                      "kind",
                      "layout",
                      "fields",
                      "status",
                      "version",
                      "updatedAt"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "template"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
