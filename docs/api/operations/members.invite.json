{
  "/api/v1/shops/{shopId}/invitations": {
    "post": {
      "operationId": "members.invite",
      "summary": "Invite someone to the shop",
      "description": "Emails an invitation to join the shop with a role. The person accepts by signing in with that email address within seven days.",
      "x-permission": "members.manage",
      "x-connection-scope": "session",
      "x-audit-action": "member.invited",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "maxLength": 320,
                  "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "manager",
                    "catalog_editor",
                    "inventory_operator",
                    "viewer"
                  ]
                }
              },
              "required": [
                "email",
                "role"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "invitationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "email": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "expiresAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "invitationId",
                  "email",
                  "role",
                  "expiresAt"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
