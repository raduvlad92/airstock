{
  "/api/v1/shops/{shopId}/members": {
    "get": {
      "operationId": "members.list",
      "summary": "List members and pending invitations",
      "x-permission": "shop.read",
      "x-connection-scope": "session",
      "x-audit-action": "members.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "members": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "membershipId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "userId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "email": {
                          "type": "string"
                        },
                        "displayName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "role": {
                          "type": "string"
                        },
                        "allLocations": {
                          "type": "boolean"
                        },
                        "locationScopeIds": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "description": "Warehouses and locations the member is limited to, when not all locations."
                        },
                        "status": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "membershipId",
                        "userId",
                        "email",
                        "displayName",
                        "role",
                        "allLocations",
                        "locationScopeIds",
                        "status"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "invitations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "invitationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "email": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "expiresAt": {
                          "type": "string"
                        },
                        "emailSentAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "invitationId",
                        "email",
                        "role",
                        "status",
                        "expiresAt",
                        "emailSentAt"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "members",
                  "invitations"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
