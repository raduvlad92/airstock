{
  "/api/v1/shops/{shopId}/pick-lists": {
    "post": {
      "operationId": "picking.lists.create",
      "summary": "Build a pick list from open reservations",
      "description": "Use this when someone is about to collect orders in the warehouse. Takes the outstanding allocations of open reservations, filtered by channel, warehouse, the date the reservation was made, or orders (an external reference or its prefix, such as shopify:order/123 for every line of that order), and makes one line per allocation, sorted by location path for a short walk. Allocations already on an open list are left out. Lines outside your locations are left out. Picking never changes stock. Not for reserving stock (use manage_reservations).",
      "x-permission": "picking.run",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "picking.list.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "channel": {
                  "description": "Only reservations of this channel, such as \"default\".",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "warehouseId": {
                  "description": "Only allocations in this warehouse.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "createdFrom": {
                  "description": "Reserved on or after this day (shop time zone).",
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "createdTo": {
                  "description": "Reserved on or before this day (shop time zone).",
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "orders": {
                  "description": "External references of orders; a reference also matches the ones that continue it after /, : or #.",
                  "minItems": 1,
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "reservationIds": {
                  "minItems": 1,
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pickListId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "completed",
                      "cancelled"
                    ]
                  },
                  "filters": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "createdAt": {
                    "type": "string"
                  },
                  "completedAt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "lines": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "openLines": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "shortLines": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "orders": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "description": "Distinct order-level reservations."
                  },
                  "version": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "partial": {
                    "type": "boolean",
                    "description": "True when your location access hides some lines."
                  },
                  "pickLines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "lineId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "sequence": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "open",
                            "picked",
                            "short",
                            "moved",
                            "done",
                            "cancelled"
                          ],
                          "description": "open: still to pick; picked; short: flagged, some units were not found; moved: taken from another position (see the new line); done: the list was completed."
                        },
                        "locationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "locationPath": {
                          "type": "string"
                        },
                        "variantId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "productName": {
                          "type": "string"
                        },
                        "variantName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "sku": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "string",
                          "description": "Base units to pick."
                        },
                        "inPacks": {
                          "type": "object",
                          "properties": {
                            "packs": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "packId": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "count": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "packId",
                                  "name",
                                  "count"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "looseUnits": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "packs",
                            "looseUnits"
                          ],
                          "additionalProperties": false,
                          "description": "The quantity in the variant’s packs, largest first, and the units left over."
                        },
                        "picked": {
                          "type": "string"
                        },
                        "short": {
                          "type": "string"
                        },
                        "moved": {
                          "type": "string"
                        },
                        "remaining": {
                          "type": "string"
                        },
                        "lotId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "lotCode": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "expiresOn": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "serialId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "serial": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "reservationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                          "description": "The order-level reservation."
                        },
                        "allocationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "positionId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "externalRef": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "fulfillOnComplete": {
                          "type": "boolean",
                          "description": "False for Shopify orders, which are fulfilled from Shopify."
                        }
                      },
                      "required": [
                        "lineId",
                        "sequence",
                        "status",
                        "locationId",
                        "locationPath",
                        "variantId",
                        "productName",
                        "variantName",
                        "sku",
                        "quantity",
                        "inPacks",
                        "picked",
                        "short",
                        "moved",
                        "remaining",
                        "lotId",
                        "lotCode",
                        "expiresOn",
                        "serialId",
                        "serial",
                        "reservationId",
                        "allocationId",
                        "positionId",
                        "externalRef",
                        "fulfillOnComplete"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "pickListId",
                  "number",
                  "status",
                  "filters",
                  "note",
                  "createdAt",
                  "completedAt",
                  "lines",
                  "openLines",
                  "shortLines",
                  "orders",
                  "version",
                  "partial",
                  "pickLines"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
