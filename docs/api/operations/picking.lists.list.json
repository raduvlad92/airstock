{
  "/api/v1/shops/{shopId}/pick-lists": {
    "get": {
      "operationId": "picking.lists.list",
      "summary": "List pick lists",
      "description": "Use this to find pick lists to work on or to check on: open ones by default, newest first, with how many lines are still open or short. Counts cover only the locations you can access.",
      "x-permission": "inventory.read",
      "x-connection-scope": "inventory:read",
      "x-audit-action": "picking.lists.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "status",
          "in": "query",
          "required": false,
          "schema": {
            "default": "open",
            "type": "string",
            "enum": [
              "open",
              "completed",
              "cancelled",
              "all"
            ]
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "default": 25,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pickLists": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "pickListId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "number": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "open",
                            "completed",
                            "cancelled"
                          ]
                        },
                        "filters": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        },
                        "note": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "completedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "lines": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "openLines": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "shortLines": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "orders": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "Distinct order-level reservations."
                        },
                        "version": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "pickListId",
                        "number",
                        "status",
                        "filters",
                        "note",
                        "createdAt",
                        "completedAt",
                        "lines",
                        "openLines",
                        "shortLines",
                        "orders",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "pickLists"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
