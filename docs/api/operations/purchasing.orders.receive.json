{
  "/api/v1/shops/{shopId}/purchase-orders/{purchaseOrderId}/receive": {
    "post": {
      "operationId": "purchasing.orders.receive",
      "summary": "Receive against a purchase order line",
      "description": "Use this when goods from a purchase order arrive. Receives into a leaf location through the normal receipt: quantity is in the line’s pack (such as cases) unless inBaseUnits is true, with lotCode and expiresOn or serials when the variant is tracked. The line’s unit cost goes into the moving average. A partial receipt keeps the rest on order; receiving more than is open is refused unless confirmOverReceipt is true, and is then recorded as an over-receipt. Not for deliveries without an order (use receive_stock).",
      "x-permission": "inventory.receive",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "purchasing.order.received",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "purchaseOrderId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "lineId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "The purchase order line."
                },
                "quantity": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$",
                  "description": "Packs of the line’s pack, or base units when the line has none or inBaseUnits is true."
                },
                "inBaseUnits": {
                  "description": "The quantity is in base units, not packs.",
                  "type": "boolean"
                },
                "locationId": {
                  "description": "A leaf location. On draft: where deliveries are received by default. On receive: where the units go (defaults to the order’s receiving location).",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "condition": {
                  "default": "sellable",
                  "type": "string",
                  "enum": [
                    "sellable",
                    "quarantine",
                    "damaged",
                    "repair",
                    "supplier_return"
                  ]
                },
                "lotCode": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "A lot or batch code. Codes are unique per variant, ignoring case and extra spaces."
                },
                "expiresOn": {
                  "description": "The lot’s expiry date (YYYY-MM-DD).",
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "producedOn": {
                  "description": "The lot’s production date (YYYY-MM-DD).",
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "serials": {
                  "description": "Serial-tracked variants: one serial per unit received.",
                  "minItems": 1,
                  "maxItems": 500,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "confirmOverReceipt": {
                  "description": "Receive more than is still open; recorded as an over-receipt.",
                  "type": "boolean"
                }
              },
              "required": [
                "lineId",
                "quantity"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "purchaseOrder": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "number": {
                        "type": "string",
                        "description": "Such as PO-0007."
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "draft",
                          "sent",
                          "partially_received",
                          "received",
                          "closed",
                          "cancelled"
                        ]
                      },
                      "supplier": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "name": {
                            "type": "string"
                          },
                          "contactName": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "email": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "phone": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "address": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "contactName",
                          "email",
                          "phone",
                          "address"
                        ],
                        "additionalProperties": false
                      },
                      "warehouse": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "name": {
                            "type": "string"
                          },
                          "address": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "address"
                        ],
                        "additionalProperties": false
                      },
                      "location": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "path": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "path"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "currency": {
                        "type": "string"
                      },
                      "expectedOn": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "supplierReference": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "notes": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "costVisible": {
                        "type": "boolean"
                      },
                      "total": {
                        "description": "Sum of line totals; needs costs.read.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "lines": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "position": {
                              "type": "number"
                            },
                            "variantId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "productId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "productName": {
                              "type": "string"
                            },
                            "variantName": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "sku": {
                              "type": "string"
                            },
                            "packId": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "packName": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "packFactor": {
                              "description": "Base units per pack when the line was written.",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "supplierItemId": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "supplierSku": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "quantity": {
                              "type": "string",
                              "description": "As ordered: packs when packId is set, else base units."
                            },
                            "ordered": {
                              "type": "string",
                              "description": "Base units."
                            },
                            "received": {
                              "type": "string",
                              "description": "Base units received against the line."
                            },
                            "cancelled": {
                              "type": "string",
                              "description": "Base units cancelled by closing or cancelling."
                            },
                            "open": {
                              "type": "string",
                              "description": "Base units still on order."
                            },
                            "overReceived": {
                              "type": "string",
                              "description": "Base units received beyond what was ordered."
                            },
                            "unitCost": {
                              "description": "Per pack, or per base unit; needs costs.read.",
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "lineTotal": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "note": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "position",
                            "variantId",
                            "productId",
                            "productName",
                            "variantName",
                            "sku",
                            "packId",
                            "packName",
                            "packFactor",
                            "supplierItemId",
                            "supplierSku",
                            "quantity",
                            "ordered",
                            "received",
                            "cancelled",
                            "open",
                            "overReceived",
                            "unitCost",
                            "lineTotal",
                            "note"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "receipts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "lineId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "operationId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "quantity": {
                              "type": "string"
                            },
                            "overReceived": {
                              "type": "string"
                            },
                            "createdAt": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "lineId",
                            "operationId",
                            "quantity",
                            "overReceived",
                            "createdAt"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "sends": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "channel": {
                              "type": "string",
                              "enum": [
                                "email",
                                "manual"
                              ]
                            },
                            "recipient": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "recorded",
                                "queued",
                                "sent",
                                "failed",
                                "suppressed"
                              ]
                            },
                            "purchaseOrderVersion": {
                              "type": "number"
                            },
                            "error": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "createdAt": {
                              "type": "string"
                            },
                            "completedAt": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "channel",
                            "recipient",
                            "status",
                            "purchaseOrderVersion",
                            "error",
                            "createdAt",
                            "completedAt"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "shop": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "sentAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "receivedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "closedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "cancelledAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "updatedAt": {
                        "type": "string"
                      },
                      "version": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "id",
                      "number",
                      "status",
                      "supplier",
                      "warehouse",
                      "location",
                      "currency",
                      "expectedOn",
                      "supplierReference",
                      "notes",
                      "costVisible",
                      "total",
                      "lines",
                      "receipts",
                      "sends",
                      "shop",
                      "createdAt",
                      "sentAt",
                      "receivedAt",
                      "closedAt",
                      "cancelledAt",
                      "updatedAt",
                      "version"
                    ],
                    "additionalProperties": false
                  },
                  "receipt": {
                    "type": "object",
                    "properties": {
                      "operationId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "lineId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "quantity": {
                        "type": "string",
                        "description": "Base units received."
                      },
                      "overReceived": {
                        "type": "string",
                        "description": "Base units beyond what the line still had open."
                      },
                      "locationId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "lot": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "lotId": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "code": {
                                "type": "string"
                              },
                              "expiresOn": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "lotId",
                              "code",
                              "expiresOn"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "serials": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "serialId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "serial": {
                              "type": "string"
                            },
                            "positionId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            }
                          },
                          "required": [
                            "serialId",
                            "serial",
                            "positionId"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "shortagesFilled": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "reservationId": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            "quantity": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "reservationId",
                            "quantity"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "averageCost": {
                        "description": "After the receipt; needs costs.read.",
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "operationId",
                      "lineId",
                      "quantity",
                      "overReceived",
                      "locationId",
                      "lot",
                      "serials",
                      "shortagesFilled",
                      "averageCost"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "purchaseOrder",
                  "receipt"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
