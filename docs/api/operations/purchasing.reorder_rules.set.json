{
  "/api/v1/shops/{shopId}/reorder-rules": {
    "post": {
      "operationId": "purchasing.reorder_rules.set",
      "summary": "Add or change a reorder rule",
      "description": "Use this to set when a variant should be reordered. Without ruleId, adds a rule for a variant at a warehouse (or one location in it); with ruleId and expectedVersion, changes it. Give a reorderPoint and either reorderQuantity (order this much) or maximumLevel (order up to this level); preferredSupplierId picks who drafts from low stock go to. A low-stock alert opens when available plus on order falls to or below the point.",
      "x-permission": "purchasing.manage",
      "x-connection-scope": "inventory:write",
      "x-audit-action": "purchasing.reorder_rule.saved",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "ruleId": {
                  "description": "An existing rule, to change it.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "variantId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "warehouseId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "locationId": {
                  "description": "A rule for one location inside the warehouse; omitted means the whole warehouse.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "reorderPoint": {
                  "description": "Alert and reorder when available plus on order is at or below this, in base units.",
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$"
                },
                "reorderQuantity": {
                  "description": "Base units to order each time (instead of maximumLevel).",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$",
                      "description": "Decimal string greater than zero, at most 14 integer digits and 6 decimal places."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maximumLevel": {
                  "description": "Order up to this many base units (instead of reorderQuantity).",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$",
                      "description": "Decimal string greater than zero, at most 14 integer digits and 6 decimal places."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "preferredSupplierId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expectedVersion": {
                  "description": "The rule version you read.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rule": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "variantId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "sku": {
                        "type": "string"
                      },
                      "productName": {
                        "type": "string"
                      },
                      "warehouseId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "warehouseName": {
                        "type": "string"
                      },
                      "locationId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "locationPath": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "reorderPoint": {
                        "type": "string"
                      },
                      "reorderQuantity": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "maximumLevel": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "preferredSupplierId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "preferredSupplierName": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "available": {
                        "type": "string",
                        "description": "Sellable and unreserved in the rule’s warehouse or location."
                      },
                      "onOrder": {
                        "type": "string",
                        "description": "Still expected on sent purchase orders there."
                      },
                      "low": {
                        "type": "boolean",
                        "description": "Available plus on order is at or below the reorder point."
                      },
                      "alertId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "The open low-stock alert, if any."
                      },
                      "version": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "id",
                      "variantId",
                      "sku",
                      "productName",
                      "warehouseId",
                      "warehouseName",
                      "locationId",
                      "locationPath",
                      "reorderPoint",
                      "reorderQuantity",
                      "maximumLevel",
                      "preferredSupplierId",
                      "preferredSupplierName",
                      "available",
                      "onOrder",
                      "low",
                      "alertId",
                      "version"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "rule"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
