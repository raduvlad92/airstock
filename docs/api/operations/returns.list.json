{
  "/api/v1/shops/{shopId}/returns": {
    "get": {
      "operationId": "returns.list",
      "summary": "List returns",
      "description": "Use this to find returns: open ones by default (requested to inspecting, and exceptions), newest first. Filter by status, order reference, or variant. Page with `before`.",
      "x-permission": "inventory.read",
      "x-connection-scope": "inventory:read",
      "x-audit-action": "returns.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "status",
          "in": "query",
          "required": false,
          "schema": {
            "default": "open",
            "type": "string",
            "enum": [
              "open",
              "closed",
              "all",
              "requested",
              "authorized",
              "in_transit",
              "received",
              "inspecting",
              "completed",
              "cancelled",
              "exception"
            ]
          }
        },
        {
          "name": "orderRef",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        {
          "name": "variantId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        {
          "name": "before",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "returns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "returnId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "reference": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "orderRef": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "fulfillmentRef": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "note": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "trackingReference": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "requested",
                            "authorized",
                            "in_transit",
                            "received",
                            "inspecting",
                            "completed",
                            "cancelled",
                            "exception"
                          ]
                        },
                        "location": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "locationId": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "path": {
                                  "type": "string"
                                },
                                "warehouseId": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "locationId",
                                "path",
                                "warehouseId"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Where the units were received, in quarantine."
                        },
                        "exception": {
                          "type": "object",
                          "properties": {
                            "open": {
                              "type": "boolean"
                            },
                            "note": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "open",
                            "note"
                          ],
                          "additionalProperties": false
                        },
                        "closed": {
                          "type": "boolean"
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "authorizedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "receivedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "completedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "version": {
                          "type": "number"
                        },
                        "totals": {
                          "type": "object",
                          "properties": {
                            "expected": {
                              "type": "string"
                            },
                            "received": {
                              "type": "string"
                            },
                            "inspected": {
                              "type": "string"
                            },
                            "uninspected": {
                              "type": "string",
                              "description": "Received, still in quarantine waiting for inspection."
                            },
                            "sellable": {
                              "type": "string"
                            },
                            "damaged": {
                              "type": "string"
                            },
                            "repair": {
                              "type": "string"
                            },
                            "supplierReturn": {
                              "type": "string"
                            },
                            "disposed": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "expected",
                            "received",
                            "inspected",
                            "uninspected",
                            "sellable",
                            "damaged",
                            "repair",
                            "supplierReturn",
                            "disposed"
                          ],
                          "additionalProperties": false
                        },
                        "lines": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "expected": {
                                "type": "string"
                              },
                              "received": {
                                "type": "string"
                              },
                              "inspected": {
                                "type": "string"
                              },
                              "uninspected": {
                                "type": "string",
                                "description": "Received, still in quarantine waiting for inspection."
                              },
                              "sellable": {
                                "type": "string"
                              },
                              "damaged": {
                                "type": "string"
                              },
                              "repair": {
                                "type": "string"
                              },
                              "supplierReturn": {
                                "type": "string"
                              },
                              "disposed": {
                                "type": "string"
                              },
                              "lineId": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "variantId": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "sku": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "entered": {
                                "anyOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "packId": {
                                        "type": "string",
                                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                      },
                                      "packName": {
                                        "type": "string"
                                      },
                                      "quantity": {
                                        "type": "string"
                                      },
                                      "factor": {
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "packId",
                                      "packName",
                                      "quantity",
                                      "factor"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "units": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "unitId": {
                                      "type": "string",
                                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                    },
                                    "lotCode": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    },
                                    "serial": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    },
                                    "received": {
                                      "type": "string"
                                    },
                                    "inspected": {
                                      "type": "string"
                                    },
                                    "matched": {
                                      "description": "Serials: false when not fulfilled from this shop (needs review).",
                                      "type": [
                                        "boolean",
                                        "null"
                                      ]
                                    },
                                    "costSource": {
                                      "type": "string",
                                      "enum": [
                                        "fulfillment",
                                        "average"
                                      ]
                                    },
                                    "unitCost": {
                                      "description": "Needs costs.read.",
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "unitId",
                                    "lotCode",
                                    "serial",
                                    "received",
                                    "inspected",
                                    "matched",
                                    "costSource",
                                    "unitCost"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "expected",
                              "received",
                              "inspected",
                              "uninspected",
                              "sellable",
                              "damaged",
                              "repair",
                              "supplierReturn",
                              "disposed",
                              "lineId",
                              "variantId",
                              "sku",
                              "name",
                              "entered",
                              "units"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "returnId",
                        "reference",
                        "orderRef",
                        "fulfillmentRef",
                        "reason",
                        "note",
                        "trackingReference",
                        "status",
                        "location",
                        "exception",
                        "closed",
                        "createdAt",
                        "authorizedAt",
                        "receivedAt",
                        "completedAt",
                        "version",
                        "totals",
                        "lines"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "next": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "returns",
                  "next"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
