{
  "/api/v1/shops/{shopId}/shopify/connections": {
    "get": {
      "operationId": "shopify.connections.list",
      "summary": "List connected Shopify stores",
      "description": "Use this when someone asks which Shopify stores are connected or how one is set up: each store with its location maps, how many variants are mapped, the Shopify locations not mapped (never synced, never guessed), webhook status, and the number of open quantity conflicts. For what is out of step and why, use action \"health\".",
      "x-permission": "shop.read",
      "x-connection-scope": "shop:read",
      "x-audit-action": "shopify.connections.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "connections": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "connectionId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "shopDomain": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "active",
                            "uninstalled"
                          ]
                        },
                        "scopes": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "uninstalledAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "shopifyLocations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "active": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "active"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "webhooks": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "topic": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string"
                              },
                              "message": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "topic",
                              "status"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "locationMaps": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "shopifyLocationId": {
                                "type": "string"
                              },
                              "shopifyLocationName": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "warehouseId": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "locationId": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "receiveLocationId": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "scopeName": {
                                "type": "string",
                                "description": "The warehouse name, or the location path."
                              }
                            },
                            "required": [
                              "shopifyLocationId",
                              "shopifyLocationName",
                              "warehouseId",
                              "locationId",
                              "receiveLocationId",
                              "scopeName"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "locationMap": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "shopifyLocationId": {
                                  "type": "string"
                                },
                                "locationId": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "shopifyLocationId",
                                "locationId"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "unmappedLocations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "active": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "active"
                            ],
                            "additionalProperties": false
                          },
                          "description": "Active Shopify locations without a map: never synced, never guessed."
                        },
                        "variantsMapped": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "conflicts": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "lastWebhookAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "connectionId",
                        "shopDomain",
                        "status",
                        "scopes",
                        "createdAt",
                        "uninstalledAt",
                        "shopifyLocations",
                        "webhooks",
                        "locationMaps",
                        "locationMap",
                        "unmappedLocations",
                        "variantsMapped",
                        "conflicts",
                        "lastWebhookAt"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "connections"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
