{
  "/api/v1/shops/{shopId}/products/{productId}/shopify-listing": {
    "post": {
      "operationId": "shopify.listings.create",
      "summary": "List a product on Shopify",
      "description": "Use this when someone wants a product they created in Airstock to appear in their Shopify store: creates it in Shopify as a draft (the default) or active product, with its options, variants, SKUs, barcodes, prices, description, and pictures, then keeps Shopify’s availability in step. Airstock owns those fields: later changes here are pushed; changes made in Shopify show as differences in sync health. Listing it again changes its status. Not for products created in Shopify (they are picked up automatically).",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "shopify.listing.requested",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "productId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "connectionId": {
                  "description": "The store; can be left out when only one is connected.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "status": {
                  "default": "draft",
                  "type": "string",
                  "enum": [
                    "draft",
                    "active"
                  ]
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "productId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "active"
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "published",
                      "failed"
                    ]
                  }
                },
                "required": [
                  "connectionId",
                  "productId",
                  "status",
                  "state"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
