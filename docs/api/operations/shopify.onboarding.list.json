{
  "/api/v1/shops/{shopId}/shopify/onboardings": {
    "get": {
      "operationId": "shopify.onboarding.list",
      "summary": "List onboarding imports",
      "description": "The latest 20 onboarding imports of the shop’s connected stores, newest first.",
      "x-permission": "shop.read",
      "x-connection-scope": "shop:read",
      "x-audit-action": "shopify.onboarding.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "connectionId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "onboardings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "onboardingId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "connectionId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "reading",
                            "matching",
                            "previewed",
                            "committing",
                            "finishing",
                            "completed",
                            "failed",
                            "cancelled"
                          ]
                        },
                        "importId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "counts": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "number"
                          }
                        },
                        "unmappedLocations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "name"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "error": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "completedAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "onboardingId",
                        "connectionId",
                        "status",
                        "importId",
                        "counts",
                        "unmappedLocations",
                        "error",
                        "createdAt",
                        "completedAt"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "onboardings"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
