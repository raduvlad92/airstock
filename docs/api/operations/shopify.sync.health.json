                                    "type": "string",
                                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "field": {
                                    "type": "string"
                                  },
                                  "airstock": {},
                                  "shopify": {},
                                  "changedBy": {
                                    "type": "string",
                                    "enum": [
                                      "shopify",
                                      "airstock"
                                    ]
                                  },
                                  "detectedAt": {
                                    "type": "string"
                                  }
