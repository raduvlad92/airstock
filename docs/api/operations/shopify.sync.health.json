                                  "scopeId",
                                  "scopeName"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "variantCount": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "variants": {
