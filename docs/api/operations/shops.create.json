{
  "/api/v1/shops": {
    "post": {
      "operationId": "shops.create",
      "summary": "Create a shop",
      "description": "Creates a shop owned by the signed-in user, with one default warehouse and location named Main stock (PRD 3.1).",
      "x-permission": "authenticated",
      "x-connection-scope": "session",
      "x-audit-action": "shop.created",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "name",
                "currency",
                "timezone"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shopId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "membershipId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "defaultWarehouseId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "defaultLocationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "shopId",
                  "membershipId",
                  "defaultWarehouseId",
                  "defaultLocationId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
