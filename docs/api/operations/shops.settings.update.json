{
  "/api/v1/shops/{shopId}/settings": {
    "post": {
      "operationId": "shops.settings.update",
      "summary": "Change the shop name, time zone, display units, or largest picture original",
      "description": "Display units choose metric or imperial in the dashboard (PRD 3.1). Stored values keep the unit they were entered in. The largest original is the longest side, in pixels, of the picture originals the shop keeps: 1,024, 2,048 (the default), or 4,096, or null for full size. The currency cannot change once set.",
      "x-permission": "shop.manage",
      "x-connection-scope": "session",
      "x-audit-action": "shop.settings.updated",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "displayUnits": {
                  "type": "string",
                  "enum": [
                    "metric",
                    "imperial"
                  ]
                },
                "mediaOriginalMaxSide": {
                  "anyOf": [
                    {
                      "type": "number",
                      "enum": [
                        1024,
                        2048,
                        4096
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Longest side in pixels of the picture originals the shop keeps; larger ones are shrunk before upload or refused. Null keeps full size."
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "displayUnits": {
                    "type": "string"
                  },
                  "mediaOriginalMaxSide": {
                    "anyOf": [
                      {
                        "type": "number",
                        "enum": [
                          1024,
                          2048,
                          4096
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Longest side in pixels of the picture originals the shop keeps; larger ones are shrunk before upload or refused. Null keeps full size."
                  },
                  "version": {
                    "type": "number"
                  }
                },
                "required": [
                  "name",
                  "timezone",
                  "displayUnits",
                  "mediaOriginalMaxSide",
                  "version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
