{
  "/api/v1/shops/{shopId}/settings": {
    "post": {
      "operationId": "shops.settings.update",
      "summary": "Change the shop name, time zone, or display units",
      "description": "Display units choose metric or imperial in the dashboard (PRD 3.1). Stored values keep the unit they were entered in. The currency cannot change once set.",
      "x-permission": "shop.manage",
      "x-connection-scope": "session",
      "x-audit-action": "shop.settings.updated",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "displayUnits": {
                  "type": "string",
                  "enum": [
                    "metric",
                    "imperial"
                  ]
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "displayUnits": {
                    "type": "string"
                  },
                  "version": {
                    "type": "number"
                  }
                },
                "required": [
                  "name",
                  "timezone",
                  "displayUnits",
                  "version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
