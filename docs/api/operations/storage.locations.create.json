{
  "/api/v1/shops/{shopId}/locations": {
    "post": {
      "operationId": "storage.locations.create",
      "summary": "Create a storage location",
      "description": "Creates a location in a warehouse, optionally inside another location. Stock is held only at locations without children, so a location that holds stock cannot gain children.",
      "x-permission": "storage.manage",
      "x-connection-scope": "storage:write",
      "x-audit-action": "storage.location.created",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "warehouseId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "parentId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The location to put it inside; null for the top level."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "code": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Short code such as A-03, unique among active locations of the warehouse."
                },
                "fulfillmentEligible": {
                  "type": "boolean",
                  "description": "Whether orders may be allocated from here. Applies to everything inside it too."
                }
              },
              "required": [
                "warehouseId",
                "name"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "locationId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "locationId",
                  "path"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
