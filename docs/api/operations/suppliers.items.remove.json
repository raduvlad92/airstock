{
  "/api/v1/shops/{shopId}/supplier-items/{itemId}/remove": {
    "post": {
      "operationId": "suppliers.items.remove",
      "summary": "Remove a supplier item",
      "description": "The supplier no longer supplies this variant or pack. The item is archived with its history.",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "supplier_item.removed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "itemId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key within 7 days returns the original result without repeating the effect. After 7 days the key is forgotten, and a request with it runs as a new one.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "expectedVersion": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "The version you read."
                }
              },
              "required": [
                "expectedVersion"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "supplierId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "supplierName": {
                        "type": "string"
                      },
                      "variantId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "productId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "productName": {
                        "type": "string"
                      },
                      "sku": {
                        "type": "string"
                      },
                      "packId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "packName": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "packBaseQuantity": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "supplierSku": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "costVisible": {
                        "type": "boolean",
                        "description": "False when you lack costs.read: lastCost is then hidden."
                      },
                      "lastCost": {
                        "description": "Per pack when packId is set, else per base unit.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "lastCostAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "minimumOrderQuantity": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "preferred": {
                        "type": "boolean"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "active",
                          "archived"
                        ]
                      },
                      "version": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "id",
                      "supplierId",
                      "supplierName",
                      "variantId",
                      "productId",
                      "productName",
                      "sku",
                      "packId",
                      "packName",
                      "packBaseQuantity",
                      "supplierSku",
                      "costVisible",
                      "lastCost",
                      "lastCostAt",
                      "minimumOrderQuantity",
                      "preferred",
                      "status",
                      "version"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "item"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
