{
  "/api/v1/shops/{shopId}/supplier-items": {
    "post": {
      "operationId": "suppliers.items.save",
      "summary": "Add or change a supplier item",
      "description": "Without itemId, records that a supplier supplies a variant (optionally in one of its packs, such as a case) with its supplier SKU. With itemId and expectedVersion, changes the given fields; null clears one. preferred: true makes it the variant’s preferred supplier item. Setting lastCost needs the costs.read permission; it is per pack when a pack is set.",
      "x-permission": "catalog.write",
      "x-connection-scope": "catalog:write",
      "x-audit-action": "supplier_item.saved",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "description": "Unique per command. Retrying with the same key returns the original result without repeating the effect.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "itemId": {
                  "description": "An existing supplier item, to change it.",
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "supplierId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "variantId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "packId": {
                  "description": "The pack the supplier sells, such as a case.",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "supplierSku": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lastCost": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$",
                      "description": "Decimal string, zero or more, at most 14 integer digits and 6 decimal places."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "minimumOrderQuantity": {
                  "description": "In packs when a pack is set, else in base units.",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d{0,13})(\\.\\d{1,6})?$",
                      "description": "Decimal string greater than zero, at most 14 integer digits and 6 decimal places."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "preferred": {
                  "type": "boolean"
                },
                "expectedVersion": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "The version you read."
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "supplierId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "supplierName": {
                        "type": "string"
                      },
                      "variantId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "productId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "productName": {
                        "type": "string"
                      },
                      "sku": {
                        "type": "string"
                      },
                      "packId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "packName": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "packBaseQuantity": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "supplierSku": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "costVisible": {
                        "type": "boolean",
                        "description": "False when you lack costs.read: lastCost is then hidden."
                      },
                      "lastCost": {
                        "description": "Per pack when packId is set, else per base unit.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "lastCostAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "minimumOrderQuantity": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "preferred": {
                        "type": "boolean"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "active",
                          "archived"
                        ]
                      },
                      "version": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "id",
                      "supplierId",
                      "supplierName",
                      "variantId",
                      "productId",
                      "productName",
                      "sku",
                      "packId",
                      "packName",
                      "packBaseQuantity",
                      "supplierSku",
                      "costVisible",
                      "lastCost",
                      "lastCostAt",
                      "minimumOrderQuantity",
                      "preferred",
                      "status",
                      "version"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "item"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
