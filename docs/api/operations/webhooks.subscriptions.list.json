{
  "/api/v1/shops/{shopId}/webhook-subscriptions": {
    "get": {
      "operationId": "webhooks.subscriptions.list",
      "summary": "List webhook subscriptions",
      "x-permission": "webhooks.manage",
      "x-connection-scope": "webhooks:manage",
      "x-audit-action": "webhooks.subscriptions.listed",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subscriptions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "subscriptionId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "eventTypes": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "filters": {
                          "type": "object",
                          "properties": {
                            "locationIds": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              }
                            },
                            "alertKinds": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "locationIds",
                            "alertKinds"
                          ],
                          "additionalProperties": false
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "active",
                            "disabled"
                          ]
                        },
                        "disabledReason": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "manual",
                                "failing"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "secretHint": {
                          "type": "string",
                          "description": "The last four characters of the current signing secret."
                        },
                        "previousSecretExpiresAt": {
                          "description": "During a rotation, deliveries carry a signature from the previous secret too.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "failingSince": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "lastSuccessAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "lastFailureAt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "updatedAt": {
                          "type": "string"
                        },
                        "version": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "subscriptionId",
                        "name",
                        "url",
                        "eventTypes",
                        "filters",
                        "status",
                        "disabledReason",
                        "secretHint",
                        "previousSecretExpiresAt",
                        "failingSince",
                        "lastSuccessAt",
                        "lastFailureAt",
                        "createdAt",
                        "updatedAt",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "subscriptions"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
