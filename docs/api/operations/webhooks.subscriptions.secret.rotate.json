{
  "/api/v1/shops/{shopId}/webhook-subscriptions/{subscriptionId}/rotate-secret": {
    "post": {
      "operationId": "webhooks.subscriptions.secret.rotate",
      "summary": "Rotate a webhook signing secret",
      "description": "Makes a new secret and returns it once. For `overlapHours` (24 by default, 0 to 168), deliveries carry signatures from both the new and the previous secret, so the receiver can switch without missing an event.",
      "x-permission": "webhooks.manage",
      "x-connection-scope": "webhooks:manage",
      "x-audit-action": "webhook.subscription.secret_rotated",
      "parameters": [
        {
          "name": "shopId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "subscriptionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "overlapHours": {
                  "default": 24,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 168
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subscription": {
                    "type": "object",
                    "properties": {
                      "subscriptionId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "name": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "eventTypes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "filters": {
                        "type": "object",
                        "properties": {
                          "locationIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                            }
                          },
                          "alertKinds": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "locationIds",
                          "alertKinds"
                        ],
                        "additionalProperties": false
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "active",
                          "disabled"
                        ]
                      },
                      "disabledReason": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "manual",
                              "failing"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "secretHint": {
                        "type": "string",
                        "description": "The last four characters of the current signing secret."
                      },
                      "previousSecretExpiresAt": {
                        "description": "During a rotation, deliveries carry a signature from the previous secret too.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "failingSince": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "lastSuccessAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "lastFailureAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "createdAt": {
                        "type": "string"
                      },
                      "updatedAt": {
                        "type": "string"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "subscriptionId",
                      "name",
                      "url",
                      "eventTypes",
                      "filters",
                      "status",
                      "disabledReason",
                      "secretHint",
                      "previousSecretExpiresAt",
                      "failingSince",
                      "lastSuccessAt",
                      "lastFailureAt",
                      "createdAt",
                      "updatedAt",
                      "version"
                    ],
                    "additionalProperties": false
                  },
                  "secret": {
                    "type": "string",
                    "description": "Shown only now."
                  }
                },
                "required": [
                  "subscription",
                  "secret"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      }
    }
  }
}
