{
  "name": "airstock",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/worker/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "parity": "tsx scripts/parity-check.ts",
    "chatgpt-run": "tsx scripts/chatgpt-run.ts",
    "chatgpt-run:shop": "tsx scripts/chatgpt-run-shop.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "openapi:bundle": "node scripts/openapi-bundle.mjs",
    "adr": "node scripts/adr-index.mjs",
    "adr:check": "node scripts/adr-index.mjs --check",
    "webhooks:docs": "tsx scripts/webhook-catalog.ts",
    "build": "pnpm --filter @airstock/web build && pnpm --filter @airstock/worker build",
    "verify": "pnpm check && pnpm typecheck && pnpm parity && pnpm openapi:check && pnpm adr:check && pnpm test && pnpm build",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "e2e": "pnpm --filter @airstock/web e2e"
  },
  "devDependencies": {
    "@airstock/core": "workspace:*",
    "@airstock/db": "workspace:*",
    "@airstock/shopify": "workspace:*",
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
